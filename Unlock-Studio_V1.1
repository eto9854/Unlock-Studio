      KEY_DB_SIZE: '密钥库体积过大，已拒绝处理',
      CANCELLED: '已取消',
      NEED_MORE: '文件头不完整',
      NOT_SUPPORTED: '暂不支持此加密格式',
      ENV: '当前浏览器环境不支持该操作'
    };
    const base = map[error.code] || error.message || '处理失败';
    const d = error.details;
    if (!d || typeof d !== 'object') return base;
    const bits = [];
    if (d.container) bits.push('容器 ' + d.container);
    if (d.version) bits.push('版本 v' + d.version);
    if (d.slot != null) bits.push('slot ' + d.slot);
    if (d.keyType) bits.push(d.keyType);
    if (d.keyBits) bits.push(d.keyBits);
    if (d.keyId) bits.push('keyId ' + d.keyId);
    if (d.mediaMid) bits.push('mediaMid ' + d.mediaMid);
    return bits.length ? base + '（' + bits.join(' · ') + '）' : base;
  }

  function keyLabel(source, errorCode) {
    if (errorCode === 'ONLINE_DRM_UNSUPPORTED') return '内存下发密钥（无本地副本）';
    if (errorCode === 'DEVICE_BOUND_KEY') return '设备绑定密钥（本机客户端密钥库）';
    if (errorCode === 'KUGOU_VERSION_UNVERIFIED') return '未知（v4 未验证）';
    if (errorCode === 'FORMAT_UNKNOWN') return '未识别（无密钥信息）';
    if (errorCode && KEY_RETRY_CODES.has(errorCode)) return '缺少密钥（需导入或粘贴）';
    if (errorCode && ['KUGOU_DECRYPT', 'QMC_DECRYPT', 'UNKNOWN_FORMAT', 'TRUNCATED', 'EMPTY_AUDIO'].includes(errorCode)) {
      return '未能确认（密钥/版本/文件问题）';
    }
    const map = {
      'embedded': '内嵌 EKey（免密）',
      'tail-key': '尾部 EKey（免密）',
      'static': 'QMCv1 静态密钥（免密）',
      'static-v1': 'QMCv1 旧静态盒（免密）',
      'kugou-db': 'KGMusicV3.db / kgg.key',
      'qq-db': 'player_process_db',
      'qq-db-scan': 'player_process_db（全表命中）',
      'manual-ekey': '手工 EKey',
      'manual-hex': '手工 hex 密钥'
    };
    if (!source) return '无需密钥';
    return map[source] || String(source);
  }

  /* ---------------- toast ---------------- */

  let toastTimer = 0;
  // 模态 dialog 位于 top layer，body 里的 toast 会被遮罩盖住；需把 toast 挂进当前 dialog
  function toastHost() {
    if (settingsDialog.open) return settingsDialog;
    if (diagDialog.open) return diagDialog;
    return document.body;
  }
  function toast(message, ms) {
    const host = toastHost();
    if (toastEl.parentElement !== host) host.appendChild(toastEl);
    toastEl.textContent = message;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), ms || 2800);
  }

  /* ---------------- settings persistence ---------------- */

  function lsGet(key, fallback) {
    try {
      const raw = localStorage.getItem('unlock.' + key);
      return raw == null ? fallback : JSON.parse(raw);
    } catch (e) {
      return fallback;
    }
  }
  function lsSet(key, value) {
    try { localStorage.setItem('unlock.' + key, JSON.stringify(value)); } catch (e) { /* 忽略 */ }
  }

  function loadSettings() {
    state.nameFormat = lsGet('nameFormat', 'source');
    if (!['source', 'artist-title', 'title-artist', 'title'].includes(state.nameFormat)) state.nameFormat = 'source';
    state.autoSave = lsGet('autoSave', true) !== false;
    state.autoPreview = lsGet('autoPreview', true) !== false;
    state.autoNext = lsGet('autoNext', false) === true;
    state.theme = lsGet('theme', 'auto');
    if (!['auto', 'dark', 'light'].includes(state.theme)) state.theme = 'auto';
    state.filter = lsGet('filter', 'all');
    if (!['all', 'done', 'failed', 'pending'].includes(state.filter)) state.filter = 'all';
  }

  let dbPromise = null;
  function openDb() {
    if (dbPromise) return dbPromise;
    dbPromise = new Promise((resolve) => {
      if (!window.indexedDB) { resolve(null); return; }
      const req = indexedDB.open('unlock-studio', 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains('kv')) db.createObjectStore('kv');
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => resolve(null);
    });
    return dbPromise;
  }
  async function idbGet(key) {
    try {
      const db = await openDb();
      if (!db) return null;
      return await new Promise((resolve) => {
        const tx = db.transaction('kv', 'readonly');
        const req = tx.objectStore('kv').get(key);
        req.onsuccess = () => resolve(req.result || null);
        req.onerror = () => resolve(null);
      });
    } catch (e) {
      return null;
    }
  }
  async function idbSet(key, value) {
    try {
      const db = await openDb();
      if (!db) return false;
      return await new Promise((resolve) => {
        const tx = db.transaction('kv', 'readwrite');
        tx.objectStore('kv').put(value, key);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => resolve(false);
      });
    } catch (e) {
      return false;
    }
  }

  function supportsDirPicker() {
    return typeof window.showDirectoryPicker === 'function';
  }

  async function queryPermission(handle, mode, interactive) {
    if (!handle) return false;
    try {
      if (typeof handle.queryPermission === 'function') {
        const stateNow = await handle.queryPermission({ mode });
        if (stateNow === 'granted') return true;
        if (!interactive || typeof handle.requestPermission !== 'function') return false;
      }
      const requested = await handle.requestPermission({ mode });
      return requested === 'granted';
    } catch (e) {
      return false;
    }
  }

  async function pickDirectory(options) {
    try {
      return await window.showDirectoryPicker(options);
    } catch (e) {
      if (e && e.name === 'AbortError') return null;
      throw e;
    }
  }

  /* ---------------- theme ---------------- */

  function resolvedTheme() {
    if (state.theme === 'dark' || state.theme === 'light') return state.theme;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme() {
    const resolved = resolvedTheme();
    document.documentElement.dataset.theme = resolved;
    const icon = resolved === 'dark' ? ICONS.sun : ICONS.moon;
    themeBtn.innerHTML = icon;
    themeBtn.title = resolved === 'dark' ? '切换到 Studio Day · Warm' : '切换到 Studio Night';
    const themeSelect = $('#themeSelect');
    if (themeSelect) themeSelect.value = state.theme;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.content = resolved === 'dark' ? '#0B0B0D' : '#F0EBE2';
  }

  function toggleTheme() {
    state.theme = resolvedTheme() === 'dark' ? 'light' : 'dark';
    lsSet('theme', state.theme);
    applyTheme();
  }

  /* ---------------- list rendering ---------------- */

  function visibleItems() {
    const q = state.query.trim().toLowerCase();
    return state.items.filter((item) => {
      if (state.filter === 'done' && item.status !== 'done') return false;
      if (state.filter === 'failed' && !(item.status === 'error' || item.status === 'cancelled')) return false;
      if (state.filter === 'pending' && !(item.status === 'queued' || item.status === 'parsing' || item.status === 'decrypting')) return false;
      if (!q) return true;
      const title = itemTitle(item).toLowerCase();
      const meta = item.meta || {};
      const artist = artistText(meta).toLowerCase();
      const album = String(meta.album || '').toLowerCase();
      const name = String(item.name || '').toLowerCase();
      const path = String(item.relativePath || '').toLowerCase();
      return title.includes(q) || artist.includes(q) || album.includes(q) || name.includes(q) || path.includes(q);
    });
  }

  function counts() {
    const out = { all: state.items.length, done: 0, failed: 0, pending: 0, saved: 0 };
    for (const item of state.items) {
      if (item.status === 'done') {
        out.done += 1;
        if (item.saveState === 'saved') out.saved += 1;
      } else if (item.status === 'error' || item.status === 'cancelled') out.failed += 1;
      else out.pending += 1;
    }
    return out;
  }

  function isRetryableFailure(item) {
    return (item.status === 'error' || item.status === 'cancelled') &&
      !STRUCTURAL_CODES.has(item.errorCode) &&
      item.errorCode !== 'KUGOU_VERSION_UNVERIFIED';
  }

  function renderSummary() {
    const c = counts();
    const total = c.all;
    if (!total) queueSummary.textContent = '把加密音乐拖进来，或从文件夹批量导入';
    else queueSummary.textContent = total + ' 个文件 · ' + c.done + ' 完成' + (c.failed ? ' · ' + c.failed + ' 失败' : '') + (c.pending ? ' · ' + c.pending + ' 进行中' : '');
    overallFill.style.width = total ? ((c.done / total) * 100) + '%' : '0%';
    saveAllBtn.disabled = c.done === 0;
    clearBtn.disabled = total === 0;
    const actionableFailed = state.items.filter(isRetryableFailure).length;
    retryAllBtn.hidden = actionableFailed === 0;
    retryCount.textContent = actionableFailed;
    if (c.all === 0) queueFootHint.textContent = '';
    else if (state.output.handle) queueFootHint.textContent = '保存：' + state.output.name;
    else queueFootHint.textContent = '保存：浏览器下载';
  }

  function renderFilters() {
    const c = counts();
    $$('#filterBar [data-filter]').forEach((btn) => {
      const key = btn.dataset.filter;
      btn.classList.toggle('is-active', state.filter === key);
      btn.setAttribute('aria-selected', state.filter === key ? 'true' : 'false');
      const el = btn.querySelector('[data-count]');
      if (el) el.textContent = c[key] == null ? 0 : c[key];
    });
  }

  function cardHtml(item) {
    const platform = platformOf(item);
    const title = itemTitle(item);
    const meta = item.meta || {};
    const artist = artistText(meta);
    const album = meta.album || '';
    const info = item.info;
    const subParts = [];
    if (artist) subParts.push(artist);
    if (album) subParts.push(album);
    subParts.push(info ? info.label : (platform.label + ' 加密'));
    const sub = subParts.filter(Boolean).join(' · ');
    const cover = item.coverUrl
      ? '<img src="' + escapeHtml(item.coverUrl) + '" alt="" loading="lazy">'
      : '<span class="cover-fallback">' + ICONS.music + '</span>';
    const percent = item.status === 'done' ? 100 : Math.round((item.progress || 0) * 100);
    const classes = 'track' + (item.id === state.selectedId ? ' is-selected' : '') + (item.isNew ? ' is-new' : '');
    const savedFlag = item.status === 'done' && item.saveState === 'saved'
      ? '<span class="saved-flag">已保存</span>'
      : '';
    const errorLine = item.status === 'error'
      ? '<span class="track-error">' + escapeHtml(item.error || '处理失败') + '</span>'
      : '';
    return '<button class="' + classes + '" type="button" data-id="' + item.id + '" data-status="' + item.status + '" title="' + escapeHtml(title + ' · ' + item.name) + '">' +
      '<span class="track-cover">' + cover + '</span>' +
      '<span class="track-main">' +
        '<span class="track-title-row">' +
          '<span class="track-title">' + escapeHtml(title) + '</span>' +
          '<span class="platform-tag">' + escapeHtml(platform.tag) + '</span>' +
        '</span>' +
        '<span class="track-sub">' + escapeHtml(sub) + '</span>' +
        '<span class="track-progress"><i style="width:' + percent + '%"></i></span>' +
        '<span class="track-bottom">' +
          '<span class="badge ' + statusClass(item) + '">' + statusText(item) + '</span>' +
          '<span class="track-hint">' + escapeHtml(itemHint(item)) + '</span>' +
          savedFlag +
        '</span>' +
        errorLine +
      '</span>' +
      '<span class="track-side">' +
        '<span class="track-format">' + escapeHtml(info ? info.label : '—') + '</span>' +
        '<span class="track-size">' + formatBytes(item.size) + '</span>' +
      '</span>' +
    '</button>';
  }

  function renderList() {
    const list = visibleItems();
    if (!state.items.length) {
      fileList.innerHTML = '<div class="list-empty"><strong>队列是空的</strong><p>把加密音乐文件拖进来<br>支持多选、文件夹与拖拽</p></div>';
      return;
    }
    if (!list.length) {
      fileList.innerHTML = '<div class="list-empty"><strong>没有匹配的文件</strong><p>换个关键词，或切回「全部」筛选。</p></div>';
      return;
    }
    fileList.innerHTML = list.map(cardHtml).join('');
  }

  /* ---------------- detail rendering ---------------- */

  function selectedItem() {
    return state.items.find((item) => item.id === state.selectedId) || null;
    }

  function setCover(item, bytes, mime) {
    if (item.coverUrl) URL.revokeObjectURL(item.coverUrl);
    item.coverBlob = new Blob([bytes], { type: mime });
    item.coverMime = mime;
    item.coverUrl = URL.createObjectURL(item.coverBlob);
  }

  function renderDetail() {
    const item = selectedItem();
    if (!item) {
      detailEmpty.hidden = false;
      detailContent.hidden = true;
      if (mediaMobile.matches) closeSheet();
      return;
    }
    detailEmpty.hidden = true;
    detailContent.hidden = false;

    const platform = platformOf(item);
    const title = itemTitle(item);
    const meta = item.meta || {};
    const artist = artistText(meta);
    const album = meta.album || '';
    const info = item.info;
    const specs = [];
    if (info) specs.push(info.label);
    if (meta.bitrate) specs.push(Math.round(meta.bitrate / 1000) + ' kbps');
    if (meta.duration) specs.push(fmtDuration(meta.duration));
    specs.push(formatBytes(item.result && item.result.blob ? item.result.blob.size : item.size));

    detailKicker.textContent = item.status === 'done' ? 'READY TO EXPORT' : (item.status === 'error' ? 'NEEDS ATTENTION' : 'PROCESSING');
    detailTitle.textContent = title;
    detailArtist.textContent = [artist, album].filter(Boolean).join(' · ') ||
      (item.status === 'done'
        ? '未找到音频标签，使用源文件名'
        : (item.status === 'error' || item.status === 'cancelled' ? '未能读取音频元信息' : '正在读取元信息…'));
    detailSpecs.textContent = specs.filter(Boolean).join(' · ');

    detailCover.innerHTML = item.coverUrl
      ? '<img src="' + escapeHtml(item.coverUrl) + '" alt="">'
      : '<div class="cover-fallback">' + ICONS.music + '</div>';

    const tagParts = [];
    tagParts.push('<span class="pill accent">' + escapeHtml(platform.tag) + ' · ' + escapeHtml(platform.label) + '</span>');
    if (item.status === 'done') tagParts.push('<span class="pill ok">已完成</span>');
    else if (item.status === 'error') tagParts.push('<span class="pill bad">失败</span>');
    else if (item.status === 'cancelled') tagParts.push('<span class="pill bad">已取消</span>');
    else tagParts.push('<span class="pill">' + statusText(item) + '</span>');
    if (item.saveState === 'saved') tagParts.push('<span class="pill ok">已保存</span>');
    if (item.plan && item.plan.cryptoVersion) tagParts.push('<span class="pill">v' + item.plan.cryptoVersion + '</span>');
    detailTags.innerHTML = tagParts.join('');

    const badges = [];
    if (item.status === 'done' && item.info) {
      badges.push('<span class="status-note">输出 .' + item.info.ext + ' · ' + formatBytes(item.result ? item.result.blob.size : item.size) + '</span>');
    } else if (item.status === 'error') {
      badges.push('<span class="status-note" style="color:var(--danger)">' + escapeHtml(item.error || '处理失败') + '</span>');
    } else if (item.status === 'decrypting') {
      badges.push('<span class="status-note">' + formatBytes(item.processedBytes || 0) + ' / ' + formatBytes(item.totalBytes || 0) + '</span>');
    } else {
      badges.push('<span class="status-note">' + escapeHtml(itemHint(item)) + '</span>');
    }
    detailBadges.innerHTML = badges.join('');

    const structural = item.status === 'error' && item.errorCode === 'ONLINE_DRM_UNSUPPORTED';
    retryBtn.hidden = structural ? true : !(item.status === 'error' || item.status === 'cancelled');
    retryBtn.disabled = structural;
    const detailCopy = item.status === 'error' && item.errorCode ? DETAIL_COPY[item.errorCode] : null;
    const store = state.keyStore;
    const imported = (store.kugou ? store.kugou.size : 0) + (store.qq ? store.qq.length : 0) + (store.manual ? store.manual.length : 0);
    const keyish = item.status === 'error' && (item.errorCode === 'DEVICE_BOUND_KEY' || KEY_RETRY_CODES.has(item.errorCode));
    const miss = keyish && imported
      ? '<p class="detail-error-miss">已导入 ' + imported + ' 条密钥（酷狗 ' + (store.kugou ? store.kugou.size : 0) +
        ' · QQ ' + (store.qq ? store.qq.length : 0) + ' · 手工 ' + (store.manual ? store.manual.length : 0) +
        '），本文件未命中；请换用下载该文件的设备/账号对应的密钥库</p>'
      : '';
    detailError.hidden = !detailCopy && !miss;
    detailError.dataset.code = (item.status === 'error' && item.errorCode) || '';
    if (!detailError.hidden) {
      detailError.innerHTML = (detailCopy
        ? '<p><strong>' + escapeHtml(detailCopy.title) + '</strong>' + escapeHtml(detailCopy.short) + '</p>'
        : '') + miss +
        (detailCopy && detailCopy.long ? '<details><summary>展开详细原因</summary><p>' + escapeHtml(detailCopy.long) + '</p></details>' : '');
    } else {
      detailError.innerHTML = '';
    }

    const isDone = item.status === 'done' && !!item.result;
    prevBtn.disabled = false;
    nextBtn.disabled = false;
    playBtn.disabled = !isDone;
    seekBar.disabled = !isDone;

    let saveLabel = '保存到输出目录';
    if (item.status !== 'done') saveLabel = '等待完成';
    else if (!state.output.handle) saveLabel = '下载文件';
    else if (item.saveState === 'saved') saveLabel = '再次保存（不覆盖）';
    else if (item.saveState === 'needs-permission') saveLabel = '授权并保存';
    saveBtn.textContent = saveLabel;
    saveBtn.title = item.status === 'done' && item.saveState === 'saved'
      ? '再次保存会另存为「原文件名 (1)」，不会覆盖已保存的文件'
      : '';
    saveBtn.disabled = !isDone;

    coverBtn.disabled = !item.coverBlob;
    const diagnostic = (item.plan && item.plan.detection) || item.detection || null;
    diagBtn.hidden = !(diagnostic || item.status === 'error' || item.errorCode);
    removeBtn.disabled = false;

    const formatSelect = $('#detailNameFormat');
    if (formatSelect) formatSelect.value = state.nameFormat;
    outputDirLabel.textContent = state.output.handle ? state.output.name : '未选择';
    outputDirLabel.title = state.output.handle ? state.output.name : '';
    saveStateText.textContent = saveStateLabel(item);

    const rows = [];
    rows.push(['源文件', item.relativePath || item.name]);
    rows.push(['平台', platform.label + ' · ' + platform.tag]);
    rows.push(['输入大小', formatBytes(item.size)]);
    if (diagnostic) {
      rows.push(['容器', (diagnostic.container || '未识别') + (diagnostic.version ? ' · v' + diagnostic.version : '')]);
      if (diagnostic.innerFormat) rows.push(['内层编码', String(diagnostic.innerFormat).toUpperCase()]);
    }
    if (item.info) rows.push(['输出格式', '.' + item.info.ext + ' · ' + item.info.label]);
    if (meta.duration) rows.push(['时长', fmtDuration(meta.duration)]);
    if (meta.bitrate) rows.push(['码率', Math.round(meta.bitrate / 1000) + ' kbps']);
    rows.push(['封面', item.coverMime ? item.coverMime.replace('image/', '').toUpperCase() : '无']);
    rows.push(['密钥', keyLabel(item.plan ? item.plan.ekeySource : (diagnostic ? diagnostic.keySource : null), item.errorCode)]);
    rows.push(['状态', statusText(item)]);
    infoGrid.innerHTML = rows.map(([k, v]) => '<div class="info-row"><span>' + escapeHtml(k) + '</span><strong title="' + escapeHtml(v) + '">' + escapeHtml(v) + '</strong></div>').join('');

    updatePlayerUI();
  }

  function updateDetailProgress(item) {
    if (item.id !== state.selectedId) return;
    const badge = detailBadges.querySelector('.status-note');
    if (badge && item.status === 'decrypting') {
      badge.textContent = formatBytes(item.processedBytes || 0) + ' / ' + formatBytes(item.totalBytes || 0);
    }
    detailTags.querySelectorAll('.pill').forEach((pill) => {
      if (pill.textContent.startsWith('解密')) pill.textContent = statusText(item);
    });
  }

  /* ---------------- player ---------------- */

  function activeItem() {
    return state.items.find((item) => item.id === state.activeId) || null;
  }

  function updatePlayerUI() {
    const item = selectedItem();
    const active = activeItem();
    const isDone = !!(item && item.status === 'done' && item.result);
    const playing = isDone && !audio.paused && !audio.ended && active && active.id === item.id;
    playBtn.innerHTML = (playing ? ICONS.pause : ICONS.play);
    playBtn.title = playing ? '暂停 (空格)' : '播放 (空格)';
    if (!item) playerState.textContent = '未选择';
    else if (!isDone) playerState.textContent = item.status === 'error' ? '解密失败' : '等待完成';
    else if (playing) playerState.textContent = '正在试听';
    else if (active && active.id === item.id && audio.currentTime > 0 && audio.paused) playerState.textContent = '已暂停';
    else playerState.textContent = '待播放';

    const duration = Number.isFinite(audio.duration) && audio.duration > 0
      ? audio.duration
      : (item && item.meta && item.meta.duration ? item.meta.duration / 1000 : 0);
    const current = active && active.id === (item && item.id) && Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
    const ratio = duration > 0 ? Math.min(1, Math.max(0, current / duration)) : 0;
    seekBar.value = String(Math.round(ratio * 1000));
    seekBar.style.setProperty('--p', (ratio * 100) + '%');
    curTime.textContent = fmtClock(current);
    totalTime.textContent = fmtClock(duration);
  }

  function pauseAudio(clear) {
    try { audio.pause(); } catch (e) { /* 忽略 */ }
    if (clear) {
      try { audio.removeAttribute('src'); audio.load(); } catch (e) { /* 忽略 */ }
      state.activeId = 0;
    }
    updatePlayerUI();
  }

  async function playItem(item, force) {
    if (!item || item.status !== 'done' || !item.result) return;
    if (state.activeId === item.id && audio.src) {
      if (audio.paused || audio.ended) {
        if (audio.ended) audio.currentTime = 0;
        try { await audio.play(); } catch (e) { toast('试听失败'); }
      }
      updatePlayerUI();
      return;
    }
    try { audio.pause(); } catch (e) { /* 忽略 */ }
    state.activeId = item.id;
    audio.src = item.result.url;
    updatePlayerUI();
    try {
      await audio.play();
    } catch (e) {
      if (force !== false) toast('浏览器阻止了自动播放，请点击播放');
    }
    updatePlayerUI();
  }

  function togglePlay() {
    const item = selectedItem();
    if (!item || item.status !== 'done') return;
    if (state.activeId === item.id && audio.src) {
      if (audio.paused || audio.ended) {
        if (audio.ended) audio.currentTime = 0;
        audio.play().catch(() => toast('试听失败'));
      } else {
        audio.pause();
      }
    } else {
      playItem(item, false);
    }
  }

  function navigate(delta) {
    const list = visibleItems();
    if (!list.length) return;
    const currentIndex = list.findIndex((item) => item.id === state.selectedId);
    let index;
    if (currentIndex < 0) index = delta < 0 ? list.length - 1 : 0;
    else index = Math.min(list.length - 1, Math.max(0, currentIndex + delta));
    const target = list[index];
    if (!target) return;
    selectItem(target.id, { autoplay: state.autoPreview && target.status === 'done', open: true });
  }

  function nextPlayable() {
    const list = visibleItems();
    const index = list.findIndex((item) => item.id === state.selectedId);
    for (let i = index + 1; i < list.length; i++) if (list[i].status === 'done') return list[i];
    return null;
  }

  /* ---------------- selection / sheet ---------------- */

  function selectItem(id, options) {
    const opts = options || {};
    const item = state.items.find((entry) => entry.id === id);
    if (!item) return;
    const changed = state.selectedId !== id;
    const wasPlaying = !audio.paused && state.activeId === id;
    state.selectedId = id;
    if (changed) {
      if (state.activeId && state.activeId !== id) pauseAudio(true);
      detailScroll.scrollTop = 0;
    }
    renderList();
    renderDetail();
    if (mediaMobile.matches && opts.open !== false) openSheet();
    if (item.status === 'done' && state.autoPreview && opts.autoplay !== false && (changed || !audio.src)) {
      playItem(item);
    } else if (
      !changed &&
      item.status === 'done' &&
      state.autoPreview &&
      opts.autoplay !== false &&
      state.activeId === id &&
      audio.src &&
      audio.paused
    ) {
      playItem(item);
    } else if (item.status !== 'done' && state.activeId && state.activeId !== id) {
      pauseAudio(true);
      renderDetail();
    }
    if (!changed && wasPlaying) updatePlayerUI();
  }

  function ensureSelectionVisible() {
    const item = selectedItem();
    if (!item) return;
    if (!visibleItems().some((entry) => entry.id === item.id)) {
      state.selectedId = 0;
      pauseAudio(true);
    }
  }

  function openSheet() {
    if (!mediaMobile.matches) return;
    detailPanel.classList.add('is-open');
    detailPanel.setAttribute('aria-hidden', 'false');
    sheetBackdrop.hidden = false;
    document.body.classList.add('sheet-open');
  }

  function closeSheet() {
    if (!mediaMobile.matches) return;
    detailPanel.classList.remove('is-open');
    detailPanel.setAttribute('aria-hidden', 'true');
    sheetBackdrop.hidden = true;
    document.body.classList.remove('sheet-open');
    detailPanel.style.transform = '';
  }

  /* ---------------- adding files：内容优先入队判定 ---------------- */

  const INGEST_HEAD = 4096;
  const INGEST_TAIL = 8192;
  const LYRIC_EXTS = new Set(['lrc', 'srt', 'ass']);
  // 候选后缀直接复用容器清单，避免 core 的容器扩展名和新加的 mgg2 之类在入队层漏掉
  const INGEST_HINT_EXTS = new Set([
    ...core.CONTAINER_EXTS,
    'qu', 'fq',
    'mp3', 'flac', 'ogg', 'm4a', 'aac'
  ]);
  const CATEGORY_LABEL = { lyrics: '歌词', text: '文本', image: '图片', video: '视频', other: '其他', plain: '已有音频' };
  const CATEGORY_ORDER = ['lyrics', 'text', 'image', 'video', 'other', 'plain'];

  function ingestExt(name) {
    const normalized = core.normalizeName(String(name || ''));
    const dot = normalized.lastIndexOf('.');
    return dot > 0 ? normalized.slice(dot + 1).toLowerCase() : '';
  }

  function readSlice(file, start, end) {
    return file.slice(start, end).arrayBuffer().then((buffer) => new Uint8Array(buffer));
  }

  function asciiAt(bytes, offset, text) {
    if (!bytes || bytes.length < offset + text.length) return false;
    for (let i = 0; i < text.length; i++) {
      if (bytes[offset + i] !== text.charCodeAt(i)) return false;
    }
    return true;
  }

  function latinText(bytes) {
    let out = '';
    for (let i = 0; i < bytes.length; i++) out += String.fromCharCode(bytes[i]);
    return out;
  }

  // 文本启发式：前 4KB 无 NUL，控制字符占比 ≤5%
  function looksLikeText(bytes) {
    if (!bytes || !bytes.length) return false;
    let control = 0;
    for (let i = 0; i < bytes.length; i++) {
      const b = bytes[i];
      if (b === 0) return false;
      if (b < 0x20 && b !== 0x09 && b !== 0x0a && b !== 0x0d && b !== 0x0c) control += 1;
      else if (b === 0x7f) control += 1;
    }
    return control / bytes.length <= 0.05;
  }

  function detectNonAudio(head) {
    if (!head || head.length < 2) return null;
    if (head[0] === 0xff && head[1] === 0xd8 && head[2] === 0xff) return { category: 'image', reason: '图片（JPEG）' };
    if (asciiAt(head, 0, '\u0089PNG')) return { category: 'image', reason: '图片（PNG）' };
    if (asciiAt(head, 0, 'GIF8')) return { category: 'image', reason: '图片（GIF）' };
    if (head[0] === 0x42 && head[1] === 0x4d) return { category: 'image', reason: '图片（BMP）' };
    if (asciiAt(head, 0, 'RIFF') && asciiAt(head, 8, 'WEBP')) return { category: 'image', reason: '图片（WEBP）' };
    if (asciiAt(head, 0, 'RIFF') && asciiAt(head, 8, 'AVI ')) return { category: 'video', reason: '视频（AVI）' };
    if (head[0] === 0x1a && head[1] === 0x45 && head[2] === 0xdf && head[3] === 0xa3) return { category: 'video', reason: '视频（Matroska/WebM）' };
    if (asciiAt(head, 0, 'SQLite format 3')) return { category: 'other', reason: '其他（SQLite 数据库）' };
    if (head[0] === 0xd0 && head[1] === 0xcf && head[2] === 0x11 && head[3] === 0xe0) return { category: 'other', reason: '其他（OLE 复合文档）' };
    if (asciiAt(head, 0, '%PDF')) return { category: 'other', reason: '其他（PDF）' };
    if (head[0] === 0x4d && head[1] === 0x5a) return { category: 'other', reason: '其他（Windows 可执行文件）' };
    if (asciiAt(head, 0, 'PK\u0003\u0004') || asciiAt(head, 0, 'PK\u0005\u0006') || asciiAt(head, 0, 'PK\u0007\u0008')) {
      return { category: 'other', reason: '其他（ZIP 压缩包）' };
    }
    return null;
  }

  // ftyp 容器：音频 brand 或含 soun 轨道才视为可播放音频，其余按视频跳过
  function classifyFtyp(head) {
    if (!asciiAt(head, 4, 'ftyp')) return null;
    const brand = String.fromCharCode(head[8] || 0, head[9] || 0, head[10] || 0, head[11] || 0);
    if (/^(M4A |M4B |F4A |F4B |aac )/i.test(brand)) return null;
    const text = latinText(head);
    if (text.includes('vide')) return { bucket: 'skip', category: 'video', reason: '视频（MP4/QuickTime）' };
    if (text.includes('soun')) return null;
    return { bucket: 'skip', category: 'video', reason: '视频容器（ftyp ' + brand.trim() + '）' };
  }

  async function classifyFile(file) {
    let head;
    try {
      head = await readSlice(file, 0, Math.min(INGEST_HEAD, file.size));
    } catch (e) {
      return { bucket: 'unrecognized', reason: '读取失败' };
    }
    const detection = core.identify(head, new Uint8Array(0), file.size, file.name);
    if (detection.kind === 'ncm' || detection.kind === 'kugou' || detection.kind === 'kugou-struct') {
      return { bucket: 'enqueue', reason: '加密容器 ' + (detection.container || '') };
    }
    if (detection.kind === 'plain') {
      if (detection.audio === 'm4a') {
        const ftyp = classifyFtyp(head);
        if (ftyp) return ftyp;
      }
      return { bucket: 'skip', category: 'plain', reason: '已是可播放音频（' + String(detection.audio || 'audio').toUpperCase() + '）' };
    }
    const other = detectNonAudio(head);
    if (other) return { bucket: 'skip', category: other.category, reason: other.reason };
    const ext = ingestExt(file.name);
    if (looksLikeText(head)) {
      const category = LYRIC_EXTS.has(ext) ? 'lyrics' : 'text';
      return {
        bucket: 'skip',
        category,
        reason: (category === 'lyrics' ? '歌词/字幕文件' : '文本文件') + (ext ? '（.' + ext + '）' : '')
      };
    }
    if (file.size > INGEST_HEAD) {
      try {
        const tail = await readSlice(file, Math.max(0, file.size - INGEST_TAIL), file.size);
        const again = core.identify(head, tail, file.size, file.name);
        if (again.kind === 'qmc') return { bucket: 'enqueue', reason: 'QMC 尾部结构（' + (again.container || '') + '）' };
      } catch (e) { /* 尾部读取失败按未识别处理 */ }
    }
    if (INGEST_HINT_EXTS.has(ext)) return { bucket: 'enqueue', reason: '待探测（.' + ext + '）' };
    return { bucket: 'unrecognized', reason: '无法判定' + (ext ? '（.' + ext + '）' : '') };
  }

  function pushItem(entry, source, result) {
    const file = entry && entry.file ? entry.file : entry;
    if (state.items.some((item) => item.name === file.name && item.size === file.size && item.file.lastModified === file.lastModified)) {
      result.duplicate += 1;
      return false;
    }
    state.items.push({
      id: ++state.seq,
      file,
      name: file.name,
      relativePath: (entry && entry.relativePath) || file.webkitRelativePath || file.name,
      source: source || 'files',
      size: file.size,
      status: 'queued',
      progress: 0,
      processedBytes: 0,
      totalBytes: 0,
      plan: null,
      meta: null,
      info: null,
      format: null,
      coverUrl: null,
      coverBlob: null,
      coverMime: null,
      result: null,
      error: null,
      cancelled: false,
      saveState: 'idle',
      savedName: null,
      saveError: null,
      isNew: true
    });
    result.added += 1;
    if (file.size > 300 * 1024 * 1024) toast('有文件超过 300MB（' + formatBytes(file.size) + '），请留意内存占用');
    return true;
  }

  async function addFiles(entries, source) {
    const result = { added: 0, duplicate: 0, empty: 0, skipped: [], unrecognized: [] };
    for (const entry of entries || []) {
      const file = entry && entry.file ? entry.file : entry;
      if (!file || !file.name) { result.empty += 1; continue; }
      if (!file.size) { result.empty += 1; continue; }
      if (state.items.some((item) => item.name === file.name && item.size === file.size && item.file.lastModified === file.lastModified)) {
        result.duplicate += 1;
        continue;
      }
      const verdict = await classifyFile(file);
      if (verdict.bucket === 'skip') {
        result.skipped.push({ name: file.name, category: verdict.category, reason: verdict.reason });
        continue;
      }
      if (verdict.bucket === 'unrecognized') {
        result.unrecognized.push({
          file,
          name: file.name,
          relativePath: (entry && entry.relativePath) || file.webkitRelativePath || file.name,
          reason: verdict.reason
        });
        continue;
      }
      pushItem(entry, source, result);
    }
    if (result.added) {
      renderAll();
      setTimeout(() => {
        state.items.forEach((item) => { item.isNew = false; });
      }, 400);
      processQueue();
    }
    return result;
  }

  function ingestCounts(result) {
    const counts = { lyrics: 0, text: 0, image: 0, video: 0, other: 0, plain: 0 };
    for (const row of result.skipped || []) counts[row.category] = (counts[row.category] || 0) + 1;
    return counts;
  }

  function ingestParts(counts, separator) {
    return CATEGORY_ORDER.filter((key) => counts[key]).map((key) => CATEGORY_LABEL[key] + ' ' + counts[key]).join(separator);
  }

  function ingestText(result, prefix) {
    const counts = ingestCounts(result);
    const skippedCount = (result.skipped || []).length;
    const unknownCount = (result.unrecognized || []).length;
    if (result.added) {
      const bits = ['已加入 ' + result.added + ' 个'];
      if (result.duplicate) bits.push('重复 ' + result.duplicate + ' 个');
      if (result.empty) bits.push('空文件 ' + result.empty + ' 个');
      if (skippedCount) {
        bits.push('跳过 ' + skippedCount + ' 个' + (counts.plain ? '' : '非音频文件') + '（' + ingestParts(counts, ' / ') + '）');
      }
      if (unknownCount) bits.push('另有 ' + unknownCount + ' 个无法判定');
      return (prefix || '') + bits.join(' · ');
    }
    if (!skippedCount && !unknownCount && !result.duplicate && !result.empty) return '';
    const bits = [];
    if (skippedCount) bits.push('已跳过 ' + skippedCount + ' 个：' + ingestParts(counts, ' · '));
    if (unknownCount) bits.push('另有 ' + unknownCount + ' 个无法判定');
    if (result.duplicate) bits.push('重复 ' + result.duplicate + ' 个');
    if (result.empty) bits.push('空文件 ' + result.empty + ' 个');
    return '没有发现可处理的加密音乐（' + bits.join('；') + '）' +
      (unknownCount ? '，可点「仍然加入」强制处理' : '');
  }

  function renderIngestNote() {
    const { skipped, unrecognized } = state.ingest;
    if (!skipped.length && !unrecognized.length) {
      ingestNote.hidden = true;
      ingestSummary.textContent = '';
      ingestList.innerHTML = '';
      forceAddBtn.hidden = true;
      forceAddBtn.textContent = '仍然加入';
      dismissIngestBtn.hidden = true;
      return;
    }
    ingestNote.hidden = false;
    ingestDetails.open = false;
    const counts = ingestCounts({ skipped });
    const pieces = [];
    if (skipped.length) {
      pieces.push('跳过 ' + skipped.length + ' 个' + (counts.plain ? '' : '非音频文件') + '（' + ingestParts(counts, ' / ') + '）');
    }
    if (unrecognized.length) pieces.push(unrecognized.length + ' 个无法判定');
    ingestSummary.textContent = pieces.join(' · ');
    const rows = skipped.map((row) => '<li>' + escapeHtml(row.name) + ' — ' + escapeHtml(row.reason) + '</li>')
      .concat(unrecognized.map((row) => '<li>' + escapeHtml(row.name) + ' — 无法判定，默认未加入</li>'));
    ingestList.innerHTML = rows.join('');
    forceAddBtn.hidden = unrecognized.length === 0;
    forceAddBtn.textContent = unrecognized.length ? '仍然加入（' + unrecognized.length + '）' : '仍然加入';
    dismissIngestBtn.hidden = false;
  }

  function unrecognizedSignature(row) {
    const file = (row && row.file) || {};
    return String((row && row.relativePath) || '') + '\u0000' + String((row && row.name) || '') +
      '\u0000' + String(file.size == null ? '' : file.size) +
      '\u0000' + String(file.lastModified == null ? '' : file.lastModified);
  }

  function skippedSignature(row) {
    return unrecognizedSignature(row) + '\u0000' + String((row && row.reason) || '');
  }

  function reportIngest(result, prefix) {
    // 连续拖入多批时保留前一批的跳过/无法判定清单，按文件签名去重，直到用户点“忽略”或清空队列
    const mergedSkipped = (state.ingest.skipped || []).slice();
    const seenSkipped = new Set(mergedSkipped.map(skippedSignature));
    for (const row of result.skipped || []) {
      const sig = skippedSignature(row);
      if (seenSkipped.has(sig)) continue;
      seenSkipped.add(sig);
      mergedSkipped.push(row);
    }
    const merged = (state.ingest.unrecognized || []).slice();
    const seen = new Set(merged.map(unrecognizedSignature));
    for (const row of result.unrecognized || []) {
      const sig = unrecognizedSignature(row);
      if (seen.has(sig)) continue;
      seen.add(sig);
      merged.push(row);
    }
    state.ingest = { skipped: mergedSkipped, unrecognized: merged };
    renderIngestNote();
    const message = ingestText(result, prefix);
    if (message) toast(message, 3800);
  }

  function forceAddPending() {
    const pending = state.ingest.unrecognized.slice();
    if (!pending.length) return;
    const result = { added: 0, duplicate: 0, empty: 0 };
    for (const entry of pending) pushItem(entry, 'forced', result);
    state.ingest = { skipped: [], unrecognized: [] };
    renderIngestNote();
    if (result.added) {
      renderAll();
      setTimeout(() => {
        state.items.forEach((item) => { item.isNew = false; });
      }, 400);
      processQueue();
      toast('已强制加入 ' + result.added + ' 个未识别文件');
    } else if (result.duplicate) {
      toast('这些文件已在队列中');
    }
  }

  /* ---------------- folder scanning ---------------- */

  async function scanDirectory(handle) {
    const files = [];
    let scanned = 0;
    let errors = 0;
    const maxEntries = 50000;
    async function walk(dir, prefix, depth) {
      if (depth > 12) return;
      let iterator;
      try {
        iterator = dir.entries();
      } catch (e) {
        errors += 1;
        return;
      }
      while (true) {
        let next;
        try {
          next = await iterator.next();
        } catch (e) {
          errors += 1;
          return;
        }
        if (next.done) break;
        const entry = next.value[1];
        const name = entry.name;
        scanned += 1;
        if (scanned > maxEntries) throw new Error('目录文件过多，已停止扫描（上限 ' + maxEntries + '）');
        if (name.startsWith('.') || name === 'node_modules' || name === '$RECYCLE.BIN' || name === 'System Volume Information') continue;
        if (entry.kind === 'file') {
          try {
            const file = await entry.getFile();
            files.push({ file, relativePath: prefix + name });
          } catch (e) {
            errors += 1;
          }
        } else if (entry.kind === 'directory') {
          await walk(entry, prefix + name + '/', depth + 1);
        }
      }
    }
    await walk(handle, '', 0);
    files.sort((a, b) => a.relativePath.localeCompare(b.relativePath, 'zh-Hans-CN', { numeric: true }));
    return { files, scanned, errors };
  }

  async function pickFolder() {
    if (!supportsDirPicker()) {
      folderInput.click();
      return;
    }
    let handle;
    try {
      handle = await pickDirectory({ mode: 'read', startIn: 'music' });
    } catch (e) {
      if (e && e.name !== 'AbortError') {
        try {
          handle = await pickDirectory({ mode: 'read' });
        } catch (e2) {
          if (e2 && e2.name !== 'AbortError') {
            toast('目录选择不可用，已改用文件夹选择器：' + e2.message, 3600);
            folderInput.click();
          }
          return;
        }
      } else return;
    }
    if (!handle) return;
    const ok = await queryPermission(handle, 'read', true);
    if (!ok) { toast('未获得读取权限'); return; }
    toast('正在扫描 ' + handle.name + '…', 1800);
    try {
      const result = await scanDirectory(handle);
      const add = await addFiles(result.files, 'folder');
      if (add.added || add.skipped.length || add.unrecognized.length) reportIngest(add, '文件夹导入：');
      else if (add.duplicate || add.empty) toast('没有新增文件（' + (add.duplicate ? add.duplicate + ' 个已在队列' : '') + (add.empty ? (add.duplicate ? ' · ' : '') + add.empty + ' 个空文件' : '') + '）');
      else toast('这个文件夹里没有文件');
    } catch (e) {
      toast('扫描失败：' + (e.message || e));
    }
  }

  function fileEntriesFromList(files) {
    return Array.from(files || []).map((file) => ({
      file,
      relativePath: file.webkitRelativePath || file.name
    }));
  }

  function readAllEntries(reader) {
    return new Promise((resolve, reject) => {
      const out = [];
      const read = () => {
        reader.readEntries((entries) => {
          if (!entries.length) { resolve(out); return; }
          out.push(...entries);
          read();
        }, reject);
      };
      read();
    });
  }

  async function collectEntry(entry, prefix, out) {
    if (!entry) return;
    if (entry.isFile) {
      const file = await new Promise((resolve, reject) => entry.file(resolve, reject));
      out.push({ file, relativePath: prefix + file.name });
      return;
    }
    if (entry.isDirectory) {
      const reader = entry.createReader();
      const entries = await readAllEntries(reader);
      for (const child of entries) await collectEntry(child, prefix + entry.name + '/', out);
    }
  }

  async function handleDrop(dataTransfer) {
    if (!dataTransfer) return;
    try {
      // 在 drop 事件同步阶段取出文件/目录句柄；之后再访问 DataTransfer 可能已失效
      const plainFiles = Array.from(dataTransfer.files || []);
      const items = dataTransfer.items;
      let files = [];
      const dirTasks = [];
      if (items && items.length) {
        for (let i = 0; i < items.length; i++) {
          const item = items[i];
          let entry = null;
          if (typeof item.webkitGetAsEntry === 'function') {
            try { entry = item.webkitGetAsEntry(); } catch (e) { entry = null; }
          }
          let handlePromise = null;
          if (typeof item.getAsFileSystemHandle === 'function') {
            try {
              handlePromise = Promise.resolve(item.getAsFileSystemHandle()).catch(() => null);
            } catch (e) {
              handlePromise = null;
            }
          }
          if (entry && entry.isDirectory) {
            dirTasks.push({ entry, handlePromise });
            continue;
          }
          let file = null;
          if (typeof item.getAsFile === 'function') {
            try { file = item.getAsFile(); } catch (e) { file = null; }
          }
          if (file) {
            files.push(file);
            continue;
          }
          if (handlePromise) dirTasks.push({ entry: null, handlePromise });
        }
      }
      if (!files.length && plainFiles.length) files = plainFiles;

      const merged = { added: 0, duplicate: 0, empty: 0, skipped: [], unrecognized: [] };
      const merge = (result) => {
        merged.added += result.added;
        merged.duplicate += result.duplicate;
        merged.empty += result.empty;
        merged.skipped.push(...result.skipped);
        merged.unrecognized.push(...result.unrecognized);
      };
      let readAny = false;
      if (files.length) {
        merge(await addFiles(fileEntriesFromList(files), 'drag'));
        readAny = true;
      }

      if (dirTasks.length) {
        toast('正在读取拖入的文件夹…', 1600);
        const out = [];
        for (const task of dirTasks) {
          let used = false;
          if (task.handlePromise) {
            try {
              const handle = await task.handlePromise;
              if (handle && handle.kind === 'directory') {
                const result = await scanDirectory(handle);
                if (result.files.length) {
                  out.push(...result.files);
                  used = true;
                }
              } else if (handle && handle.kind === 'file') {
                const file = await handle.getFile();
                out.push({ file, relativePath: file.name });
                used = true;
              }
            } catch (e) { /* 回退到旧版 FileSystemEntry 接口 */ }
          }
          if (!used && task.entry) {
            try { await collectEntry(task.entry, '', out); } catch (e) { /* 忽略单个目录错误 */ }
          }
        }
        if (out.length) {
          merge(await addFiles(out, 'drag'));
          readAny = true;
        }
      }

      if (merged.added || merged.skipped.length || merged.unrecognized.length) {
        reportIngest(merged, '');
      } else if (!readAny) {
        toast('文件夹里没有读到文件；如果浏览器限制读取，请点上方「文件夹」按钮选择');
      } else {
        toast(merged.duplicate || merged.empty
          ? '没有新增文件（' + (merged.duplicate ? merged.duplicate + ' 个已在队列' : '') + (merged.empty ? (merged.duplicate ? ' · ' : '') + merged.empty + ' 个空文件' : '') + '）'
          : '没有读到文件');
      }
    } catch (e) {
      toast('读取拖入文件失败：' + (e.message || e));
    }
  }

  /* ---------------- output directory ---------------- */

  async function pickOutputDir(interactive) {
    if (!supportsDirPicker()) {
      toast('当前浏览器不支持目录写入；请用「保存」逐个下载（建议 Chrome / Edge）', 3600);
      return false;
    }
    let handle;
    try {
      handle = await pickDirectory({
        id: 'unlock-output',
        mode: 'readwrite',
        startIn: state.output.handle || 'downloads'
      });
    } catch (e) {
      if (e && e.name === 'AbortError') return false;
      try {
        handle = await pickDirectory({ mode: 'readwrite' });
      } catch (e2) {
        if (e2 && e2.name === 'AbortError') return false;
        toast('无法访问输出目录：' + (e2.message || e2), 3600);
        return false;
      }
    }
    if (!handle) return false;
    const ok = await queryPermission(handle, 'readwrite', interactive !== false);
    if (!ok) {
      state.output = { handle, name: handle.name, permission: 'prompt' };
      renderSummary();
      renderDirs();
      toast('已选择目录，但还没有写入权限；点「授权并保存」再确认一次');
      return false;
    }
    state.output = { handle, name: handle.name, permission: 'granted' };
    state.reservedSave.clear();
    await idbSet('output', { handle, name: handle.name });
    renderSummary();
    renderDirs();
    toast('输出目录：' + handle.name);
    if (state.autoSave) await saveDoneItems();
    return true;
  }

  async function resetOutputDir() {
    state.output = { handle: null, name: '', permission: 'unknown' };
    state.reservedSave.clear();
    if (state.autoSave) {
      state.autoSave = false;
      lsSet('autoSave', false);
    }
    await idbSet('output', null);
    renderAll();
    toast('已改回浏览器下载');
  }

  async function outputFileExists(name) {
    if (!state.output.handle) return false;
    try {
      await state.output.handle.getFileHandle(name, { create: false });
      return true;
    } catch (e) {
      if (e && e.name === 'NotFoundError') return false;
      if (e && (e.name === 'NotAllowedError' || e.name === 'SecurityError')) throw e;
      return true;
    }
  }

  async function uniqueOutputName(item) {
    const filename = outputFilename(item);
    const dot = filename.lastIndexOf('.');
    const stem = dot >= 0 ? filename.slice(0, dot) : filename;
    const ext = dot >= 0 ? filename.slice(dot) : '';
    let candidate = filename;
    let i = 1;
    while (state.reservedSave.has(candidate) || await outputFileExists(candidate)) {
      candidate = stem + ' (' + i + ')' + ext;
      i += 1;
      if (i > 999) break;
    }
    state.reservedSave.add(candidate);
    return candidate;
  }

  function uniqueDownloadName(item) {
    const filename = outputFilename(item);
    const dot = filename.lastIndexOf('.');
    const stem = dot >= 0 ? filename.slice(0, dot) : filename;
    const ext = dot >= 0 ? filename.slice(dot) : '';
    let candidate = filename;
    let i = 1;
    while (state.reservedDownload.has(candidate)) {
      candidate = stem + ' (' + i + ')' + ext;
      i += 1;
      if (i > 999) break;
    }
    state.reservedDownload.add(candidate);
    return candidate;
  }

  function triggerDownload(url, filename) {
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  function downloadItem(item) {
    if (!item || !item.result) return;
    const name = uniqueDownloadName(item);
    triggerDownload(item.result.url, name);
    toast('已开始下载：' + name);
  }

  async function saveItem(item, options) {
    const opts = options || {};
    if (!item || item.status !== 'done' || !item.result) return false;
    if (item.saveState === 'saving') return false;
    if (!state.output.handle) {
      if (opts.auto) {
        item.saveState = 'idle';
        return false;
      }
      // 没有输出目录时按钮文案是「下载文件」，就直接下载；选目录只走「保存到文件夹 / 选择」
      downloadItem(item);
      return true;
    }
    if (state.output.permission !== 'granted') {
      const granted = await queryPermission(state.output.handle, 'readwrite', !!opts.interactive);
      if (!granted) {
        state.output.permission = 'prompt';
        item.saveState = 'needs-permission';
        renderAll();
        if (opts.interactive) toast('请在弹出的权限提示中允许写入');
        return false;
      }
      state.output.permission = 'granted';
    }
    item.saveState = 'saving';
    item.saveError = null;
    renderList();
    if (item.id === state.selectedId) renderDetail();
    let name = '';
    try {
      name = await uniqueOutputName(item);
      const fileHandle = await state.output.handle.getFileHandle(name, { create: true });
      const writable = await fileHandle.createWritable();
      await writable.write(item.result.blob);
      await writable.close();
      item.saveState = 'saved';
      item.savedName = name;
      item.saveError = null;
      if (item.id === state.selectedId) renderDetail();
      renderList();
      renderSummary();
      return true;
    } catch (e) {
      if (name) state.reservedSave.delete(name);
      item.saveState = 'error';
      item.saveError = e && e.name === 'NotAllowedError' ? '没有写入权限' : (e.message || String(e));
      if (item.id === state.selectedId) renderDetail();
      renderList();
      toast('保存失败：' + item.saveError);
      return false;
    }
  }

  async function saveDoneItems() {
    const done = state.items.filter((item) => item.status === 'done' && item.saveState !== 'saved');
    if (!done.length) return;
    if (!state.output.handle) {
      toast('还没有选择输出目录');
      return;
    }
    let saved = 0;
    for (const item of done) {
      if (await saveItem(item, { auto: true })) saved += 1;
    }
    if (saved) toast('已保存 ' + saved + ' 个文件到 ' + state.output.name);
    else if (done.some((item) => item.saveState === 'needs-permission')) {
      toast('输出目录需要写入权限：点「授权并保存」或在浏览器提示中允许');
    }
  }

  /* ---------------- processing ---------------- */

  function nextTick() {
    return new Promise((resolve) => setTimeout(resolve, 0));
  }

  function assertAlive(item) {
    if (item.cancelled || !state.items.includes(item)) throw new core.UnlockError('CANCELLED', '已取消');
  }

  async function buildItemPlan(item) {
    let probeSize = Math.min(item.size, 64 * 1024);
    let probe = await readSlice(item.file, 0, probeSize);
    // 尾部窗口必须覆盖 QTag 的完整 payload（不再有 4096 硬上限）
    const tailStart = Math.max(0, item.size - 32768);
    const tail = await readSlice(item.file, tailStart, item.size);
    let plan = null;
    while (true) {
      assertAlive(item);
      try {
        item.detection = core.identify(probe, tail, item.size, item.name);
        item.probeHead = probe.slice(0, 64);
        item.tailHex = core.hexDump(tail.slice(Math.max(0, tail.length - 4096)), 4096);
        plan = core.buildPlan(probe, tail, item.size, item.name, state.keyStore);
        break;
      } catch (error) {
        if (error.code === 'NEED_MORE' && error.needed <= item.size && error.needed <= MAX_PROBE) {
          const nextSize = Math.min(item.size, Math.max(error.needed, probeSize * 2));
          if (nextSize > probeSize) {
            probeSize = nextSize;
            probe = await readSlice(item.file, 0, probeSize);
            continue;
          }
        }
        throw error;
      }
    }
    if (!plan) throw new core.UnlockError('BAD_HEADER', '无法读取文件头');
    return plan;
  }

  function mergeTags(item, tags) {
    if (!tags) return;
    const meta = tags.metadata;
    if (meta) {
      if (!item.meta) item.meta = {};
      ['musicName', 'album', 'duration', 'bitrate', 'year', 'genre'].forEach((key) => {
        if (!item.meta[key] && meta[key]) item.meta[key] = meta[key];
      });
      if (!item.meta.artist && meta.artist) item.meta.artist = meta.artist;
    }
    if (tags.duration && (!item.meta || !item.meta.duration)) {
      if (!item.meta) item.meta = {};
      item.meta.duration = tags.duration;
    }
    if (!item.coverBlob && tags.cover && tags.cover.bytes && tags.cover.bytes.length) {
      setCover(item, tags.cover.bytes, tags.cover.mime);
    }
  }

  async function processItem(item) {
    if (item.status !== 'queued') return;
    item.status = 'parsing';
    item.error = null;
    item.progress = 0;
    item.processedBytes = 0;
    item.totalBytes = 0;
    renderList();
    if (item.id === state.selectedId) renderDetail();

    try {
      assertAlive(item);
      const plan = await buildItemPlan(item);
      assertAlive(item);
      item.plan = plan;
      item.meta = plan.metadata || null;
      item.format = plan.format || null;
      item.info = plan.format ? (core.FORMAT_INFO[plan.format] || null) : null;

      if (plan.coverLength > 0 && plan.coverLength <= 16 * 1024 * 1024) {
        try {
          assertAlive(item);
          const coverBytes = await readSlice(item.file, plan.coverOffset, plan.coverOffset + plan.coverLength);
          const mime = core.detectCoverMime(coverBytes);
          if (mime) setCover(item, coverBytes, mime);
        } catch (e) {
          if (e && e.code === 'CANCELLED') throw e;
          /* 封面可选，失败不影响音频 */
        }
      }

      item.status = 'decrypting';
      item.totalBytes = plan.audioLength;
      item.progress = 0;
      item.processedBytes = 0;
      renderList();
      if (item.id === state.selectedId) renderDetail();

      const parts = [];
      let position = 0;
      while (position < plan.audioLength) {
        assertAlive(item);
        const end = Math.min(plan.audioLength, position + CHUNK);
        const input = await readSlice(item.file, plan.audioOffset + position, plan.audioOffset + end);
        assertAlive(item);
        const output = new Uint8Array(input.length);
        plan.cipher.decrypt(input, output, position);
        if (position === 0) {
          const headFmt = core.sniffFormat(output);
          if (!headFmt) throw new core.UnlockError('UNKNOWN_FORMAT', '解密后无法识别音频格式');
          item.format = headFmt;
          item.info = core.FORMAT_INFO[headFmt] || null;
          if (!item.info) throw new core.UnlockError('UNKNOWN_FORMAT', '未知音频格式');
        }
        parts.push(output);
        position = end;
        item.processedBytes = position;
        item.progress = position / plan.audioLength;
        paintItem(item);
        if (item.id === state.selectedId) updateDetailProgress(item);
        await nextTick();
      }

      assertAlive(item);
      const blob = new Blob(parts, { type: item.info.mime });
      item.result = { blob, url: URL.createObjectURL(blob) };

      const tags = core.extractTags(parts[0], blob.size);
      mergeTags(item, tags);

      item.status = 'done';
      item.progress = 1;
      item.processedBytes = plan.audioLength;
      renderAll();

      if (state.autoSave) await saveItem(item, { auto: true });

      if (item.id === state.selectedId && state.autoPreview) {
        playItem(item);
      }
    } catch (error) {
      if (!state.items.includes(item)) return;
      if (error && error.code === 'CANCELLED') {
        item.status = 'cancelled';
        item.progress = 0;
      } else {
        item.status = 'error';
        item.errorCode = error && error.code ? error.code : null;
        item.errorDetails = error && error.details ? error.details : null;
        item.error = friendlyError(error);
      }
      renderAll();
    }
  }

  async function processQueue() {
    if (state.running) return;
    state.running = true;
    try {
      while (true) {
        const next = state.items.find((item) => item.status === 'queued');
        if (!next) break;
        await processItem(next);
      }
    } finally {
      state.running = false;
      renderSummary();
    }
  }

  function resetItem(item) {
    if (item.status === 'parsing' || item.status === 'decrypting') return;
    if (state.activeId === item.id) pauseAudio(true);
    if (item.result && item.result.url) URL.revokeObjectURL(item.result.url);
    if (item.coverUrl) URL.revokeObjectURL(item.coverUrl);
    item.result = null;
    item.coverUrl = null;
    item.coverBlob = null;
    item.coverMime = null;
    item.plan = null;
    item.meta = null;
    item.info = null;
    item.format = null;
    item.error = null;
    item.errorCode = null;
    item.errorDetails = null;
    item.progress = 0;
    item.processedBytes = 0;
    item.totalBytes = 0;
    item.cancelled = false;
    item.saveState = 'idle';
    item.savedName = null;
    item.saveError = null;
    item.status = 'queued';
    item.isNew = false;
  }

  function retryItem(item) {
    if (item.status === 'parsing' || item.status === 'decrypting') return;
    resetItem(item);
    renderAll();
    processQueue();
  }

  function retryAllFailed() {
    const failed = state.items.filter(isRetryableFailure);
    if (!failed.length) return;
    failed.forEach(resetItem);
    renderAll();
    toast('已重新排队 ' + failed.length + ' 个失败项');
    processQueue();
  }

  function removeItem(item) {
    item.cancelled = true;
    if (state.activeId === item.id) pauseAudio(true);
    if (item.result && item.result.url) URL.revokeObjectURL(item.result.url);
    if (item.coverUrl) URL.revokeObjectURL(item.coverUrl);
    state.items = state.items.filter((entry) => entry !== item);
    if (state.selectedId === item.id) {
      state.selectedId = 0;
      if (mediaMobile.matches) closeSheet();
    }
    renderAll();
  }

  function clearAll() {
    state.items.forEach((item) => {
      item.cancelled = true;
      if (item.result && item.result.url) URL.revokeObjectURL(item.result.url);
      if (item.coverUrl) URL.revokeObjectURL(item.coverUrl);
    });
    state.items = [];
    state.selectedId = 0;
    state.ingest = { skipped: [], unrecognized: [] };
    pauseAudio(true);
    closeSheet();
    state.reservedSave.clear();
    state.reservedDownload.clear();
    renderAll();
    renderIngestNote();
    toast('已清空队列');
  }

  function paintItem(item) {
    const card = fileList.querySelector('[data-id="' + item.id + '"]');
    if (!card) return;
    card.dataset.status = item.status;
    const percent = item.status === 'done' ? 100 : Math.round((item.progress || 0) * 100);
    const fill = card.querySelector('.track-progress i');
    if (fill) fill.style.width = percent + '%';
    const badge = card.querySelector('.badge');
    if (badge) {
      badge.className = 'badge ' + statusClass(item);
      badge.textContent = statusText(item);
    }
    const hint = card.querySelector('.track-hint');
    if (hint) hint.textContent = itemHint(item);
  }

  /* ---------------- directory rendering ---------------- */

  function renderDirs() {
    const outputName = state.output.handle ? state.output.name : '未选择';
    if (outputDirLabel) {
      outputDirLabel.textContent = outputName;
      outputDirLabel.title = outputName;
    }
    if (settingsOutputLabel) {
      settingsOutputLabel.textContent = outputName;
      settingsOutputLabel.title = outputName;
    }
    if (outputDirBtn) {
      outputDirBtn.title = state.output.handle
        ? '当前保存到 ' + state.output.name + '；点击更换文件夹'
        : '选择后「全部保存」和自动保存会写入该文件夹';
    }
    if (resetOutputRow) resetOutputRow.hidden = !state.output.handle;
    const k = state.keyStore.kugou.size;
    const q = state.keyStore.qq.length;
    const m = state.keyStore.manual.length;
    if (keyStatus) {
      keyStatus.textContent = (k || q || m)
        ? '已载入：酷狗 ' + k + ' 个 · QQ ' + q + ' 个' + (m ? ' · 手工 ' + m + ' 个' : '')
        : '未导入（KGG / 部分 QMC 需要）';
      keyStatus.dataset.state = (k || q || m) ? 'ok' : 'idle';
    }
  }

  /* ---------------- settings UI ---------------- */

  function syncSettings() {
    $$('[data-switch]').forEach((btn) => {
      const key = btn.dataset.switch;
      if (key in state) btn.setAttribute('aria-checked', state[key] ? 'true' : 'false');
    });
    $$('[data-setting="nameFormat"]').forEach((sel) => { sel.value = state.nameFormat; });
    const themeSelect = $('#themeSelect');
    if (themeSelect) themeSelect.value = state.theme;
    renderDirs();
  }

  function setSetting(key, value) {
    state[key] = value;
    lsSet(key, value);
    syncSettings();
    if (key === 'autoSave' && value) saveDoneItems();
  }

  /* ---------------- render all ---------------- */

  function renderAll() {
    renderSummary();
    renderFilters();
    renderList();
    renderDetail();
    renderDirs();
    syncSettings();
  }

  /* ---------------- key import ---------------- */

  function rebuildQqIndex() {
    const byName = new Map();
    const byPath = new Map();
    const add = (map, key, ekey) => {
      if (!key || !ekey) return;
      if (!map.has(key)) map.set(key, []);
      const arr = map.get(key);
      if (!arr.includes(ekey)) arr.push(ekey);
    };
    for (const entry of state.keyStore.qq) {
      const path = String(entry.path || '');
      const name = String(entry.name || (path.replace(/\\/g, '/').split('/').pop()));
      const lowerName = name.toLowerCase();
      const dot = lowerName.lastIndexOf('.');
      add(byName, lowerName, entry.ekey);
      if (dot > 0) add(byName, lowerName.slice(0, dot), entry.ekey);
      add(byPath, path.toLowerCase(), entry.ekey);
    }
    state.keyStore.qqByName = byName;
    state.keyStore.qqByPath = byPath;
  }

  async function importKeys(files) {
    const list = Array.from(files || []);
    if (!list.length) return;
    let addedK = 0;
    let addedQ = 0;
    let failed = 0;
    const qqSeen = new Set(state.keyStore.qq.map((entry) => entry.path + '\u0000' + entry.ekey));
    for (const file of list) {
      if (keyStatus) keyStatus.textContent = '读取 ' + file.name + '…';
      try {
        const buffer = await file.arrayBuffer();
        const bundle = await core.loadKeyBundle(buffer, file.name, (ratio) => {
          if (keyStatus) keyStatus.textContent = '解密密钥库 ' + Math.round(ratio * 100) + '%…';
        });
        for (const [id, ekey] of bundle.kugou) {
          state.keyStore.kugou.set(id, ekey);
          addedK += 1;
        }
        for (const entry of bundle.qq) {
          const sig = entry.path + '\u0000' + entry.ekey;
          if (qqSeen.has(sig)) continue;
          qqSeen.add(sig);
          state.keyStore.qq.push(entry);
          addedQ += 1;
        }
      } catch (e) {
        failed += 1;
        toast(file.name + '：' + friendlyError(e), 3600);
      }
    }
    rebuildQqIndex();
    renderDirs();
    if (addedK || addedQ) {
      const retried = retryKeyItems();
      toast('密钥已载入：酷狗 ' + state.keyStore.kugou.size + ' 个 · QQ ' + state.keyStore.qq.length + ' 个' +
        (retried ? '；已自动重试 ' + retried + ' 个缺密钥文件' : '；可点「重试失败」重新处理'), 3600);
    } else if (failed) {
      if (keyStatus) keyStatus.textContent = '未导入';
    }
  }

  const KEY_RETRY_CODES = new Set([
    'KUGOU_KEY_MISSING', 'KUGOU_KEY_INVALID', 'QMC_KEY_MISSING', 'QMC_KEY_INVALID'
  ]);

  const STRUCTURAL_CODES = new Set([
    'ONLINE_DRM_UNSUPPORTED'
  ]);

  // 设备绑定密钥只要导入本机密钥库就能解，必须保留重试；只有内存下发的才不可重试
  const RETRY_ON_IMPORT_CODES = new Set([...KEY_RETRY_CODES, 'DEVICE_BOUND_KEY']);

  const DETAIL_COPY = {
    DEVICE_BOUND_KEY: {
      title: '设备绑定密钥，缺的是本机密钥库',
      short: '密钥不在文件内，需在同一台设备导入本机客户端的密钥库；没有该库则无法解密。',
      long: '导入后会自动重试：QQ 用 player_process_db，酷狗用 %APPDATA%\\KuGou8\\KGMusicV3.db（有 kgg.key 时一并导入）。请在同一台设备上解密你自己下载的文件。'
    },
    ONLINE_DRM_UNSUPPORTED: {
      title: '在线 DRM，密钥不在本地',
      short: '密钥由服务端在会话中下发，只存在于播放器进程内存，本地没有任何持久副本；任何离线工具都无法解密。',
      long: '建议在下载该文件的同一台设备、同一账号下处理，例如用能正常播放它的官方客户端导出明文。'
    },
    KUGOU_VERSION_UNVERIFIED: {
      title: 'KGM v4 未验证',
      short: '目前没有 KGM v4 的真实样本与参考实现，无法确认密钥结构，不能保证解密。',
      long: '可用「格式诊断」导出前 64B / 尾 4096B 十六进制反馈。'
    }
  };

  function retryKeyItems() {
    let count = 0;
    for (const item of state.items) {
      if (item.status === 'error' && RETRY_ON_IMPORT_CODES.has(item.errorCode)) {
        resetItem(item);
        count += 1;
      }
    }
    if (count) {
      renderAll();
      processQueue();
    }
    return count;
  }

  function hexToBytes(text) {
    const raw = String(text || '').replace(/0x/gi, '').replace(/[^0-9a-fA-F]/g, '');
    if (raw.length !== 32 && raw.length !== 64) return null;
    const out = new Uint8Array(raw.length / 2);
    for (let i = 0; i < out.length; i += 1) out[i] = parseInt(raw.slice(i * 2, i * 2 + 2), 16);
    return out;
  }

  function sameBytes(a, b) {
    if (!a || !b || a.length !== b.length) return false;
    for (let i = 0; i < a.length; i += 1) if (a[i] !== b[i]) return false;
    return true;
  }

  function addManualKey(text) {
    const raw = String(text || '').trim();
    if (!raw) {
      toast('先粘贴 Base64 EKey 或 32/64 位 hex');
      return;
    }
    const bytes = hexToBytes(raw);
    let entry;
    if (bytes) {
      entry = { master: bytes, source: 'manual-hex' };
    } else {
      try {
        const master = core.deriveQmcKey(raw);
        entry = { ekey: raw, source: 'manual-ekey', derived: master.length };
      } catch (e) {
        toast('无法识别这个密钥：' + friendlyError(e), 3600);
        return;
      }
    }
    const dup = state.keyStore.manual.some((item) =>
      (entry.ekey && item.ekey === entry.ekey) || (entry.master && item.master && sameBytes(item.master, entry.master)));
    if (dup) {
      manualKeyInput.value = '';
      toast('这个密钥已经在当前页面内存里了');
      return;
    }
    state.keyStore.manual.push(entry);
    manualKeyInput.value = '';
    renderDirs();
    const retried = retryKeyItems();
    toast((entry.master ? '已添加 hex 密钥' : '已添加 EKey') +
      (retried ? '；已自动重试 ' + retried + ' 个缺密钥文件' : '；当前没有待重试的缺密钥项'), 3600);
  }

  /* ---------------- diagnostics ---------------- */

  async function ensureDiagBytes(item) {
    if (!item.probeHead || !item.probeHead.length) {
      try {
        item.probeHead = await readSlice(item.file, 0, Math.min(item.size, 64));
      } catch (e) { /* 忽略 */ }
    }
    if (!item.tailHex) {
      try {
        const start = Math.max(0, item.size - 4096);
        item.tailHex = core.hexDump(await readSlice(item.file, start, item.size), 4096);
      } catch (e) { /* 忽略 */ }
    }
  }

  function diagReport(item) {
    const det = (item.plan && item.plan.detection) || item.detection || null;
    const d = item.errorDetails || {};
    const container = (det && det.container) || d.container || '未识别';
    const version = (det && det.version) || d.version || null;
    const summary = [
      ['文件名', item.relativePath || item.name],
      ['大小', formatBytes(item.size) + '（' + item.size + ' B）'],
      ['容器', container + (version ? ' · v' + version : '')],
      ['内层编码', (item.info && item.info.ext) || (det && det.innerFormat) || '未确定'],
      ['密钥来源', keyLabel(item.plan ? item.plan.ekeySource : (det ? det.keySource : null), item.errorCode)],
      ['识别结果', item.status === 'error' ? (item.error || '处理失败') : (item.status === 'done' ? '已完成' : statusText(item))]
    ];
    if (item.errorCode) summary.push(['错误码', item.errorCode]);
    if (d.keyId) summary.push(['keyId', d.keyId]);
    if (d.mediaMid) summary.push(['mediaMid', d.mediaMid]);
    if (d.keyType) summary.push(['密钥类型', d.keyType]);
    if (d.keyBits) summary.push(['密钥位数', d.keyBits]);
    const hint = (det && det.hint) || core.peelName(item.name);
    summary.push(['后缀提示链', (hint.hints || []).join(' → ') || '无']);
    const evidence = (det && det.evidence && det.evidence.length)
      ? det.evidence.slice()
      : ['没有可用的判定依据（文件头读取失败或识别层未执行）'];
    const candidates = (det && det.candidates && det.candidates.length)
      ? det.candidates.slice()
      : ['ncm', 'kgm/vpr/kgg', 'mflac/mgg/qmc', '普通音频'];
    const head = core.hexDump(item.probeHead || [], 64) || (det && det.magicHex) || '（无）';
    const tail = item.tailHex || (det && det.tailHex) || '（无）';
    return { summary, evidence, candidates, head, tail };
  }

  function fillDiag(item) {
    const report = diagReport(item);
    diagSummary.innerHTML = report.summary
      .map(([k, v]) => '<div class="diag-row"><span>' + escapeHtml(k) + '</span><strong title="' + escapeHtml(v) + '">' + escapeHtml(v) + '</strong></div>')
      .join('');
    diagEvidence.innerHTML = report.evidence
      .map((line) => '<div class="diag-row"><span>·</span><strong>' + escapeHtml(line) + '</strong></div>')
      .join('');
    diagCandidates.innerHTML = report.candidates
      .map((line) => '<div class="diag-row"><span></span><code>' + escapeHtml(line) + '</code></div>')
      .join('');
    diagHead.value = report.head;
    diagTail.value = report.tail;
  }

  function diagText(item) {
    const report = diagReport(item);
    return [
      'Unlock Studio 格式诊断',
      '文件名：' + (item.relativePath || item.name),
      '大小：' + item.size + ' B',
      '',
      '== 摘要 ==',
      ...report.summary.map(([k, v]) => k + '：' + v),
      '',
      '== 判定依据 ==',
      ...report.evidence.map((line) => '- ' + line),
      '',
      '== 候选格式 ==',
      ...report.candidates.map((line) => '- ' + line),
      '',
      '== 前 64B hex ==',
      report.head,
      '',
      '== 尾 4096B hex ==',
      report.tail
    ].join('\n');
  }

  async function openDiag(id) {
    const item = state.items.find((entry) => entry.id === id) || selectedItem();
    if (!item) return;
    await ensureDiagBytes(item);
    fillDiag(item);
    if (typeof diagDialog.showModal === 'function') {
      if (!diagDialog.open) diagDialog.showModal();
    } else {
      diagDialog.setAttribute('open', '');
    }
  }

  function fallbackCopy(text) {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.top = '50%';
    area.style.left = '50%';
    area.style.transform = 'translate(-50%, -50%)';
    area.style.width = 'min(680px, 92vw)';
    area.style.height = '38vh';
    area.style.zIndex = '9999';
    area.style.background = 'var(--surface)';
    area.style.color = 'var(--ink)';
    area.style.border = '1px solid var(--accent)';
    area.style.padding = '10px';
    area.className = 'diag-hex';
    // 回到普通文档层会被 modal 的遮罩盖住，必须放进当前 top layer 的 dialog
    const host = diagDialog.open ? diagDialog : (settingsDialog.open ? settingsDialog : document.body);
    host.appendChild(area);
    area.focus();
    area.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    if (ok) area.remove();
    else area.addEventListener('blur', () => area.remove(), { once: true });
    return ok;
  }

  async function copyDiag() {
    const item = state.items.find((entry) => entry.id === state.selectedId) || selectedItem();
    if (!item) return;
    const text = diagText(item);
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(text);
        toast('诊断信息已复制（含前 64B / 尾 4096B hex）', 3000);
        return;
      }
    } catch (e) { /* 走回退 */ }
    toast(fallbackCopy(text)
      ? '诊断信息已复制'
      : '自动复制被浏览器拦截：已弹出文本框并全选，请按 Ctrl+C', 4200);
  }

  function exportDiag() {
    const item = state.items.find((entry) => entry.id === state.selectedId) || selectedItem();
    if (!item) return;
    const blob = new Blob([diagText(item)], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = core.peelName(item.name).base + '-diag.txt';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(url), 4000);
    toast('诊断已导出为 .txt');
  }

  function openKeySettings() {
    if (typeof settingsDialog.showModal === 'function') {
      if (!settingsDialog.open) settingsDialog.showModal();
    } else {
      settingsDialog.setAttribute('open', '');
    }
    const target = manualKeyInput;
    if (!target) return;
    setTimeout(() => {
      target.scrollIntoView({ block: 'center' });
      if (typeof target.focus === 'function') target.focus();
    }, 60);
  }

  /* ---------------- events ---------------- */

  themeBtn.addEventListener('click', toggleTheme);
  settingsBtn.addEventListener('click', () => {
    if (typeof settingsDialog.showModal === 'function') settingsDialog.showModal();
    else settingsDialog.setAttribute('open', '');
  });
  settingsDialog.addEventListener('click', (event) => {
    if (event.target === settingsDialog) settingsDialog.close();
  });
  [settingsDialog, diagDialog].forEach((dialog) => {
    dialog.addEventListener('close', () => {
      if (toastEl.parentElement === dialog) document.body.appendChild(toastEl);
    });
  });

  $('#addFilesBtn').addEventListener('click', () => fileInput.click());
  $('#addFolderBtn').addEventListener('click', pickFolder);
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      fileInput.click();
    }
  });

  let dragDepth = 0;
  dropzone.addEventListener('dragenter', (event) => {
    event.preventDefault();
    dragDepth += 1;
    dropzone.classList.add('dragover');
  });
  dropzone.addEventListener('dragover', (event) => {
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy';
  });
  dropzone.addEventListener('dragleave', (event) => {
    event.preventDefault();
    dragDepth -= 1;
    if (dragDepth <= 0) { dragDepth = 0; dropzone.classList.remove('dragover'); }
  });
  dropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    dragDepth = 0;
    dropzone.classList.remove('dragover');
    handleDrop(event.dataTransfer);
  });
  window.addEventListener('dragover', (event) => { event.preventDefault(); });
  window.addEventListener('drop', (event) => {
    event.preventDefault();
    if (event.target.closest && event.target.closest('#dropzone')) return;
    handleDrop(event.dataTransfer);
  });

  fileInput.addEventListener('change', async () => {
    const result = await addFiles(fileEntriesFromList(fileInput.files), 'files');
    fileInput.value = '';
    if (result.added || result.skipped.length || result.unrecognized.length || result.empty) reportIngest(result, '');
    else if (result.duplicate) toast('没有新增文件（' + result.duplicate + ' 个已在队列）');
  });
  folderInput.addEventListener('change', async () => {
    const entries = Array.from(folderInput.files || []).map((file) => ({ file, relativePath: file.webkitRelativePath || file.name }));
    const result = await addFiles(entries, 'folder');
    folderInput.value = '';
    if (result.added || result.skipped.length || result.unrecognized.length || result.empty) reportIngest(result, '文件夹导入：');
    else if (result.duplicate) toast('没有新增文件（' + result.duplicate + ' 个已在队列）');
  });
  forceAddBtn.addEventListener('click', forceAddPending);
  dismissIngestBtn.addEventListener('click', () => {
    state.ingest = { skipped: [], unrecognized: [] };
    renderIngestNote();
  });
  keyInput.addEventListener('change', () => {
    importKeys(keyInput.files);
    keyInput.value = '';
  });
  $('#keyImportBtn').addEventListener('click', () => keyInput.click());
  manualKeyBtn.addEventListener('click', () => addManualKey(manualKeyInput.value));
  manualKeyInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      addManualKey(manualKeyInput.value);
      manualKeyInput.value = '';
    }
  });
  $$('[data-open-keys]').forEach((btn) => {
    btn.addEventListener('click', () => openKeySettings());
  });

  diagBtn.addEventListener('click', () => openDiag(state.selectedId));
  diagCopyBtn.addEventListener('click', copyDiag);
  diagExportBtn.addEventListener('click', exportDiag);
  [diagHead, diagTail].forEach((el) => {
    if (el) el.addEventListener('focus', () => el.select());
  });

  pickOutputBtn.addEventListener('click', () => pickOutputDir(true));
  settingsPickOutputBtn.addEventListener('click', () => pickOutputDir(true));
  outputDirBtn.addEventListener('click', () => pickOutputDir(true));
  resetOutputBtn.addEventListener('click', resetOutputDir);

  searchInput.addEventListener('input', () => {
    state.query = searchInput.value;
    ensureSelectionVisible();
    renderAll();
  });
  filterBar.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-filter]');
    if (!btn) return;
    state.filter = btn.dataset.filter;
    lsSet('filter', state.filter);
    ensureSelectionVisible();
    renderAll();
  });

  fileList.addEventListener('click', (event) => {
    const card = event.target.closest('.track');
    if (!card) return;
    const id = Number(card.dataset.id);
    if (id) selectItem(id, { autoplay: state.autoPreview });
  });

  $$('[data-switch]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.switch;
      if (!(key in state)) return;
      setSetting(key, !state[key]);
    });
  });
  $$('[data-setting="nameFormat"]').forEach((sel) => {
    sel.addEventListener('change', () => {
      state.nameFormat = sel.value;
      lsSet('nameFormat', state.nameFormat);
      syncSettings();
      renderList();
      renderDetail();
    });
  });
  const themeSelect = $('#themeSelect');
  if (themeSelect) {
    themeSelect.addEventListener('change', () => {
      state.theme = themeSelect.value;
      lsSet('theme', state.theme);
      applyTheme();
    });
  }

  saveAllBtn.addEventListener('click', async () => {
    if (state.output.handle) {
      const granted = await queryPermission(state.output.handle, 'readwrite', true);
      if (!granted) {
        state.output.permission = 'prompt';
        renderDirs();
        toast('需要写入权限：请在浏览器提示中允许，或重新选择输出目录');
        return;
      }
      state.output.permission = 'granted';
      await saveDoneItems();
      return;
    }
    const done = state.items.filter((item) => item.status === 'done' && item.result);
    if (!done.length) return;
    done.forEach((item, index) => setTimeout(() => downloadItem(item), index * 180));
    toast('已开始下载 ' + done.length + ' 个文件；若被浏览器拦截，请允许多个下载', 3600);
  });
  retryAllBtn.addEventListener('click', retryAllFailed);
  clearBtn.addEventListener('click', clearAll);

  prevBtn.addEventListener('click', () => navigate(-1));
  nextBtn.addEventListener('click', () => navigate(1));
  playBtn.addEventListener('click', togglePlay);
  seekBar.addEventListener('input', () => {
    const item = selectedItem();
    if (!item || item.status !== 'done' || state.activeId !== item.id) return;
    const fallback = item.meta && item.meta.duration ? item.meta.duration / 1000 : 0;
    const duration = Number.isFinite(audio.duration) && audio.duration > 0 ? audio.duration : fallback;
    if (!duration) return;
    audio.currentTime = (Number(seekBar.value) / 1000) * duration;
    updatePlayerUI();
  });

  saveBtn.addEventListener('click', () => {
    const item = selectedItem();
    if (!item) return;
    saveItem(item, { interactive: true });
  });
  coverBtn.addEventListener('click', () => {
    const item = selectedItem();
    if (!item || !item.coverBlob) return;
    const ext = item.coverMime === 'image/png' ? 'png' : 'jpg';
    triggerDownload(item.coverUrl, outputStem(item) + ' - 封面.' + ext);
    toast('已开始下载封面');
  });
  retryBtn.addEventListener('click', () => {
    const item = selectedItem();
    if (item) retryItem(item);
  });
  removeBtn.addEventListener('click', () => {
    const item = selectedItem();
    if (item) removeItem(item);
  });
  closeDetailBtn.addEventListener('click', closeSheet);
  sheetBackdrop.addEventListener('click', closeSheet);
  $('#openSettingsFromDetail').addEventListener('click', () => {
    if (mediaMobile.matches) closeSheet();
    if (typeof settingsDialog.showModal === 'function') settingsDialog.showModal();
    else settingsDialog.setAttribute('open', '');
  });

  audio.addEventListener('play', updatePlayerUI);
  audio.addEventListener('pause', updatePlayerUI);
  audio.addEventListener('timeupdate', updatePlayerUI);
  audio.addEventListener('loadedmetadata', updatePlayerUI);
  audio.addEventListener('durationchange', updatePlayerUI);
  audio.addEventListener('ended', () => {
    updatePlayerUI();
    if (state.autoNext) {
      const next = nextPlayable();
      if (next) {
        selectItem(next.id, { autoplay: true, open: false });
        if (!state.autoPreview) playItem(next);
      }
    }
  });
  audio.addEventListener('error', () => {
    if (!state.activeId || !audio.currentSrc) return;
    toast('试听失败');
    state.activeId = 0;
    updatePlayerUI();
  });

  document.addEventListener('keydown', (event) => {
    if (settingsDialog.open || diagDialog.open) return;
    const target = event.target;
    if (target && target.closest && target.closest('input, textarea, select, [contenteditable="true"]')) return;
    // 焦点在按钮/链接上时，空格留给原生激活；方向键仍可切换队列
    if (event.key === ' ' && target && target.closest && target.closest('button, a')) return;
    if (event.key === ' ') {
      if (!selectedItem()) return;
      event.preventDefault();
      togglePlay();
    } else if (event.key === 'ArrowLeft') {
      if (!state.items.length) return;
      event.preventDefault();
      navigate(-1);
    } else if (event.key === 'ArrowRight') {
      if (!state.items.length) return;
      event.preventDefault();
      navigate(1);
    } else if (event.key === 'Escape') {
      if (settingsDialog.open) return;
      closeSheet();
    }
  });

  mediaMobile.addEventListener('change', () => {
    if (mediaMobile.matches) {
      if (state.selectedId) { detailPanel.setAttribute('aria-hidden', 'true'); }
    } else {
      detailPanel.classList.remove('is-open');
      detailPanel.setAttribute('aria-hidden', 'false');
      detailPanel.style.transform = '';
      sheetBackdrop.hidden = true;
      document.body.classList.remove('sheet-open');
    }
  });

  // sheet 下拉关闭
  (function bindSheetGrip() {
    const grip = $('.sheet-grip');
    if (!grip) return;
    let startY = 0;
    let dragging = false;
    let delta = 0;
    const onDown = (event) => {
      if (!mediaMobile.matches) return;
      dragging = true;
      startY = event.clientY;
      delta = 0;
      detailPanel.style.transition = 'none';
      grip.setPointerCapture && grip.setPointerCapture(event.pointerId);
    };
    const onMove = (event) => {
      if (!dragging) return;
      delta = Math.max(0, event.clientY - startY);
      detailPanel.style.transform = 'translateY(' + delta + 'px)';
    };
    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      detailPanel.style.transition = '';
      if (delta > 84) closeSheet();
      detailPanel.style.transform = '';
      delta = 0;
    };
    grip.addEventListener('pointerdown', onDown);
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);
  })();

  async function restoreHandles() {
    const output = await idbGet('output');
    if (output && output.handle) {
      state.output = { handle: output.handle, name: output.name || output.handle.name, permission: 'unknown' };
      const ok = await queryPermission(output.handle, 'readwrite', false);
      state.output.permission = ok ? 'granted' : 'prompt';
    }
    renderAll();
  }

  /* ---------------- init ---------------- */

  loadSettings();
  applyTheme();
  if (window.matchMedia) {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const onChange = () => { if (state.theme === 'auto') applyTheme(); };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
    else if (mq.addListener) mq.addListener(onChange);
  }
  if (mediaMobile.matches) detailPanel.setAttribute('aria-hidden', 'true');
  renderAll();
  restoreHandles();
  if (state.theme === 'auto') applyTheme();
})();

</script>

</body></html>
