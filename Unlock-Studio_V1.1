  function analyzeQmcTail(tail, fileSize) {
    if (!tail || tail.length < 8) return null;
    const len = tail.length;
    const total = Number(fileSize) > 0 ? Number(fileSize) : 0;
    const audioLength = (footerSize) => (total ? Math.max(0, total - footerSize) : null);

    if (tail[len - 4] === 0x53 && tail[len - 3] === 0x54 && tail[len - 2] === 0x61 && tail[len - 1] === 0x67) {
      const payloadLen = u32be(tail, len - 8);
      if (!payloadLen || payloadLen + 8 > len) return null;
      const payload = tail.subarray(len - 8 - payloadLen, len - 8);
      const parts = utf8Decode(payload).split(',');
      return {
        type: 'STag', totalSize: payloadLen + 8, audioLength: audioLength(payloadLen + 8),
        songid: /^\d+$/.test(parts[0]) ? parts[0] : null,
        mediaMid: parts.length >= 3 ? parts[parts.length - 1] : null,
        payloadLen, ekey: null
      };
    }

    if (tail[len - 4] === 0x51 && tail[len - 3] === 0x54 && tail[len - 2] === 0x61 && tail[len - 1] === 0x67) {
      const payloadLen = u32be(tail, len - 8);
      if (!payloadLen || payloadLen + 8 > len) return null;
      const payload = tail.subarray(len - 8 - payloadLen, len - 8);
      const comma = indexOfByte(payload, 0x2c);
      if (comma <= 0) return null;
      const keyBytes = payload.subarray(0, comma);
      if (keyBytes.length < 16 || !isBase64Text(keyBytes)) return null;
      const rest = latin1Decode(payload.subarray(comma + 1)).split(',');
      return {
        type: 'QTag', totalSize: payloadLen + 8, audioLength: audioLength(payloadLen + 8),
        ekey: latin1Decode(keyBytes), keyType: 'EKey',
        songid: /^\d+$/.test(rest[0]) ? rest[0] : null,
        mediaMid: rest.length > 1 ? rest[1] : null,
        rest, payloadLen
      };
    }

    if (tail[len - 8] === 0x6d && tail[len - 7] === 0x75 && tail[len - 6] === 0x73 && tail[len - 5] === 0x69 &&
        tail[len - 4] === 0x63 && tail[len - 3] === 0x65 && tail[len - 2] === 0x78 && tail[len - 1] === 0x00) {
      if (len < 16) return null;
      const footerSize = u32le(tail, len - 16);
      const version = u32le(tail, len - 12);
      if (!footerSize || footerSize > 0x2000 || footerSize < 0x9c || version !== 1) return null;
      if (footerSize > len) return null;
      const footer = tail.subarray(len - footerSize, len);
      const mediaMid = readUtf16leFixed(footer.subarray(0x0c, 0x48));
      const resourceFilename = readUtf16leFixed(footer.subarray(0x48, 0x8c));
      return {
        type: 'MusicEx', totalSize: footerSize, audioLength: audioLength(footerSize),
        mediaMid, resourceFilename, ekey: null
      };
    }

    const size = u32le(tail, len - 4);
    if (size > 0 && size <= 0x500 && size + 4 <= len) {
      const keyBytes = tail.subarray(len - 4 - size, len - 4);
      let end = keyBytes.length;
      while (end > 0 && keyBytes[end - 1] === 0) end--;
      const trimmed = keyBytes.subarray(0, end);
      if (trimmed.length >= 16 && isBase64Text(trimmed)) {
