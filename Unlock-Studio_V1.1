<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark"><head>
<meta charset="UTF-8">
<meta name="viewport" content="viewport-fit=cover, width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0B0B0D">
<meta name="description" content="在浏览器本地解开网易云 NCM、酷狗 KGM/KGMA/KGG/VPR、QQ 音乐 MFLAC/MGG/QMC 加密音频，导出原始音频；不上传，不转码。">
<title>Unlock Studio — 加密音乐解锁</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23E8A33D'/%3E%3Cpath d='M9 23V9h3l8 9V9h3v14h-3l-8-9v9z' fill='%2317110A'/%3E%3C/svg%3E">
<style>
:root,
[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0b0b0d;
  --bg-art: radial-gradient(1100px 520px at 16% -12%, rgba(232, 163, 61, 0.10), transparent 62%),
            radial-gradient(900px 480px at 100% 0%, rgba(232, 163, 61, 0.045), transparent 60%);
  --surface: #17171a;
  --surface-2: #202024;
  --surface-3: #2a2a30;
  --ink: #f3f0e9;
  --muted: #9a948a;
  --faint: #6f6a62;
  --line: rgba(243, 240, 233, 0.12);
  --line-strong: rgba(243, 240, 233, 0.22);
  --accent: #e8a33d;
  --accent-strong: #f0b45c;
  --accent-ink: #17110a;
  --accent-soft: rgba(232, 163, 61, 0.12);
  --accent-soft-strong: rgba(232, 163, 61, 0.20);
  --ok: #7ecba5;
  --ok-soft: rgba(126, 203, 165, 0.12);
  --warn: #e8a33d;
  --danger: #f07d6c;
  --danger-soft: rgba(240, 125, 108, 0.12);
  --shadow: 0 1px 0 rgba(255, 255, 255, 0.03), 0 18px 50px rgba(0, 0, 0, 0.38);
  --shadow-hover: 0 1px 0 rgba(255, 255, 255, 0.04), 0 26px 66px rgba(0, 0, 0, 0.48);
  --header-bg: rgba(11, 11, 13, 0.74);
  --focus: rgba(232, 163, 61, 0.28);
  --scrim: rgba(0, 0, 0, 0.55);
}

[data-theme="light"] {
  color-scheme: light;
  --bg: #f0ebe2;
  --bg-art: radial-gradient(1000px 520px at 14% -10%, rgba(178, 106, 22, 0.10), transparent 62%),
            radial-gradient(900px 500px at 100% 0%, rgba(178, 106, 22, 0.05), transparent 58%);
  --surface: #fbf8f2;
  --surface-2: #f5efe5;
  --surface-3: #ebe3d6;
  --ink: #1a1917;
  --muted: #6e675d;
  --faint: #9a9184;
  --line: rgba(26, 25, 23, 0.11);
  --line-strong: rgba(26, 25, 23, 0.22);
  --accent: #b26a16;
  --accent-strong: #c77c1f;
  --accent-ink: #fff8ef;
  --accent-soft: #f0e4d2;
  --accent-soft-strong: #e7d6be;
  --ok: #2f7d58;
  --ok-soft: #e2f0e8;
  --warn: #a86412;
  --danger: #a83a2b;
  --danger-soft: #f7e4df;
  --shadow: 0 1px 0 rgba(0, 0, 0, 0.03), 0 14px 36px rgba(40, 30, 10, 0.08);
  --shadow-hover: 0 1px 0 rgba(0, 0, 0, 0.03), 0 22px 52px rgba(40, 30, 10, 0.12);
  --header-bg: rgba(240, 235, 226, 0.84);
  --focus: rgba(178, 106, 22, 0.22);
  --scrim: rgba(20, 16, 10, 0.40);
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html {
  min-height: 100%;
  -webkit-text-size-adjust: 100%;
}
body {
  margin: 0;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--ink);
  font: 400 14px/1.6 var(--font-sans, "Inter", "SF Pro Text", ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif);
  background-color: var(--bg);
  background-image: var(--bg-art);
  background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
body.sheet-open { overflow: hidden; }
a { color: inherit; }
button, input, select { font: inherit; color: inherit; }
button {
  padding: 0;
  border: 0;
  background: none;
  cursor: pointer;
}
button:disabled { cursor: default; }
::selection { background: var(--accent); color: var(--accent-ink); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
[data-theme="dark"] ::-webkit-scrollbar,
[data-theme="dark"] * { scrollbar-color: rgba(243, 240, 233, 0.22) transparent; scrollbar-width: thin; }
[data-theme="light"] * { scrollbar-color: rgba(26, 25, 23, 0.18) transparent; scrollbar-width: thin; }

.mono,
.kicker,
.brand-sub,
.badge,
.mini-btn,
.saved-flag {
  font-family: var(--font-mono, "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace);
}

/* ---------------- header ---------------- */

.app-header {
  flex: none;
  position: sticky;
  top: 0;
  z-index: 40;
  border-bottom: 1px solid var(--line);
  background: var(--header-bg);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  backdrop-filter: blur(20px) saturate(140%);
}
.header-inner {
  max-width: 1440px;
  height: 64px;
  margin: 0 auto;
  padding: 0 28px;
  display: flex;
  align-items: center;
  gap: 18px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--ink);
}
.brand-mark {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: var(--accent-ink);
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06) inset;
}
.brand-mark svg { width: 17px; height: 17px; }
.brand-text { display: flex; flex-direction: column; gap: 1px; }
.brand-name {
  font-size: 14px;
  font-weight: 650;
  letter-spacing: -0.025em;
  line-height: 1.15;
}
.brand-sub {
  color: var(--faint);
  font-size: 8.5px;
  letter-spacing: 0.16em;
  line-height: 1.3;
}
.header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 7px;
}
.icon-btn {
  flex: none;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  border: 1px solid transparent;
  color: var(--muted);
  transition: background var(--t-fast, 150ms) ease, color var(--t-fast, 150ms) ease, border-color var(--t-fast, 150ms) ease, transform var(--t-fast, 150ms) ease;
}
.icon-btn:hover {
  color: var(--ink);
  background: var(--surface-2);
  border-color: var(--line);
}
.icon-btn:active { transform: scale(0.96); }
.icon-btn svg { width: 17px; height: 17px; }

/* ---------------- shell ---------------- */

.app-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  width: min(1440px, calc(100% - 48px));
  max-width: 1440px;
  margin: 0 auto;
  padding: 20px 0 16px;
}
.workspace {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(360px, 412px) minmax(0, 1fr);
  gap: 16px;
}
.panel {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  box-shadow: var(--shadow);
  overflow: hidden;
}

/* ---------------- queue ---------------- */

.queue-panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding: 20px 20px 14px;
}
.kicker {
  display: block;
  margin-bottom: 5px;
  color: var(--accent);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.head-copy h1 {
  margin: 0;
  font-size: 20px;
  font-weight: 650;
  line-height: 1.15;
  letter-spacing: -0.035em;
}
.summary {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}
.head-actions {
  display: flex;
  gap: 6px;
  padding-top: 2px;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 12px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-size: 11.5px;
  font-weight: 550;
  line-height: 1.2;
  white-space: nowrap;
  text-decoration: none;
  transition: background var(--t-fast, 150ms) ease, color var(--t-fast, 150ms) ease, border-color var(--t-fast, 150ms) ease, transform var(--t-fast, 150ms) ease, opacity var(--t-fast, 150ms) ease;
}
.btn:active { transform: scale(0.985); }
.btn:disabled { opacity: 0.42; transform: none; }
.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.16) inset;
}
.btn-primary:hover:not(:disabled) { background: var(--accent-strong); }
.btn-ghost {
  border-color: var(--line);
  color: var(--muted);
  background: transparent;
}
.btn-ghost:hover:not(:disabled) {
  color: var(--ink);
  border-color: var(--line-strong);
  background: var(--surface-2);
}
.btn-danger { color: var(--danger); }
.btn-danger:hover:not(:disabled) { color: var(--danger); border-color: var(--danger); background: var(--danger-soft); }
.btn svg { width: 13px; height: 13px; }
.btn .count {
  padding: 1px 5px;
  border-radius: 999px;
  background: var(--danger-soft);
  color: var(--danger);
  font: 9px var(--font-mono, ui-monospace, monospace);
}
.overall {
  height: 2px;
  background: var(--surface-2);
  flex: none;
}
.overall span {
  display: block;
  width: 0;
  height: 100%;
  border-radius: 999px;
  background: var(--accent);
  transition: width 380ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* dropzone */

.dropzone {
  margin: 12px 16px 0;
  padding: 13px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px dashed var(--line-strong);
  border-radius: 12px;
  background:
    linear-gradient(135deg, var(--accent-soft), transparent 58%),
    var(--surface-2);
  cursor: pointer;
  outline: none;
  transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
}
.dropzone:hover { border-color: var(--accent); transform: translateY(-1px); }
.dropzone.dragover {
  border-color: var(--accent);
  background: var(--accent-soft-strong);
  box-shadow: 0 0 0 4px var(--focus);
}
.dropzone-icon {
  flex: none;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: var(--accent-ink);
}
.dropzone-icon svg { width: 18px; height: 18px; }
.dropzone-copy { min-width: 0; flex: 1; }
.dropzone-copy strong {
  display: block;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.dropzone-copy span {
  display: block;
  margin-top: 2px;
  color: var(--muted);
  font-size: 10.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dropzone-copy .drop-active { display: none; }
.dropzone.dragover .drop-idle { display: none; }
.dropzone.dragover .drop-active { display: inline; }

.mini-btn {
  padding: 4px 7px;
  border: 1px solid transparent;
  border-radius: 7px;
  color: var(--muted);
  font-size: 9.5px;
  letter-spacing: 0.02em;
  transition: color 140ms ease, background 140ms ease, border-color 140ms ease;
}
.mini-btn:hover:not(:disabled) { color: var(--ink); background: var(--surface-3); }
.mini-btn:disabled { opacity: 0.4; }

/* tools */

.queue-tools {
  padding: 12px 16px 10px;
  display: flex;
  flex-direction: column;
  gap: 9px;
  flex: none;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 10px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface-2);
  transition: border-color 140ms ease, background 140ms ease;
}
.search-box:focus-within { border-color: var(--accent); background: var(--surface); }
.search-box svg { flex: none; width: 13px; height: 13px; color: var(--faint); }
.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  font-size: 11.5px;
}
.search-box input::placeholder { color: var(--faint); }
.filter-bar {
  display: flex;
  gap: 3px;
  padding: 3px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface-2);
}
.filter {
  flex: 1;
  min-width: 0;
  padding: 4px 4px;
  border-radius: 6px;
  color: var(--faint);
  font-size: 9.5px;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition: background 140ms ease, color 140ms ease;
}
.filter span {
  color: var(--faint);
  font: 9px var(--font-mono, ui-monospace, monospace);
  font-variant-numeric: tabular-nums;
}
.filter:hover { color: var(--ink); }
.filter.is-active {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
}
.filter.is-active span { color: var(--accent); }

/* list */

.queue-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  border-top: 1px solid var(--line);
}
.ingest-note {
  margin: 10px 16px 0;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: var(--surface-2);
}
.ingest-summary { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
.ingest-actions { display: flex; align-items: center; gap: 8px; margin-top: 7px; flex-wrap: wrap; }
.ingest-force { padding: 4px 10px; font-size: 10.5px; }
.ingest-details { margin-top: 6px; }
.ingest-details summary { cursor: pointer; color: var(--faint); font-size: 10.5px; outline: none; }
.ingest-details summary:hover { color: var(--muted); }
.ingest-list {
  margin: 6px 0 0;
  padding-left: 16px;
  max-height: 160px;
  overflow-y: auto;
}
.ingest-list li { color: var(--muted); font-size: 10.5px; line-height: 1.65; word-break: break-all; }
.track {
  width: 100%;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  gap: 11px;
  align-items: center;
  padding: 11px 16px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  color: var(--ink);
  background: transparent;
  transition: background 150ms ease;
}
.track:last-child { border-bottom: 0; }
.track:hover { background: var(--surface-2); }
.track.is-selected {
  background:
    linear-gradient(90deg, var(--accent-soft), transparent 72%),
    var(--surface-2);
  box-shadow: inset 2px 0 0 var(--accent);
}
.track.is-new { animation: trackIn 260ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.track-cover {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 9px;
  border: 1px solid var(--line);
  overflow: hidden;
  background: linear-gradient(135deg, var(--surface-3), var(--surface-2));
}
.track-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.cover-fallback {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: var(--faint);
}
.cover-fallback svg { width: 18px; height: 18px; }
.track-main { min-width: 0; }
.track-title-row {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
}
.track-title {
  min-width: 0;
  overflow: hidden;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: -0.012em;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.platform-tag {
  flex: none;
  padding: 1px 5px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--faint);
  font: 8px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.05em;
}
.track-sub {
  margin-top: 2px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.track-progress {
  display: block;
  height: 2px;
  margin-top: 7px;
  border-radius: 999px;
  background: var(--surface-3);
  overflow: hidden;
}
.track-progress i {
  display: block;
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width 180ms linear, background 200ms ease;
}
.track[data-status="done"] .track-progress i { background: var(--ok); }
.track[data-status="error"] .track-progress i { background: var(--danger); }
.track-bottom {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 6px;
  min-width: 0;
}
.badge {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--faint);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.badge::before {
  content: "";
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
}
.badge.run { color: var(--accent); }
.badge.run::before { animation: pulse 1.1s ease-in-out infinite; }
.badge.ok { color: var(--ok); }
.badge.bad { color: var(--danger); }
.track-hint {
  min-width: 0;
  color: var(--faint);
  font-size: 10px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.track-error {
  margin: 5px 0 0;
  color: var(--danger);
  font-size: 9.5px;
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.track-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;
  padding-top: 1px;
}
.track-format {
  color: var(--ink);
  font: 9.5px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.06em;
}
.track-size {
  color: var(--faint);
  font: 9.5px var(--font-mono, ui-monospace, monospace);
  font-variant-numeric: tabular-nums;
}
.saved-flag { color: var(--ok); font-size: 8.5px; }
.list-empty {
  padding: 34px 20px;
  text-align: center;
  color: var(--faint);
}
.list-empty strong {
  display: block;
  margin-bottom: 5px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}
.list-empty p { margin: 0; font-size: 10.5px; line-height: 1.6; }
.queue-foot {
  flex: none;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}
.queue-foot .foot-hint {
  margin-left: auto;
  min-width: 0;
  color: var(--faint);
  font-size: 9.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------------- detail ---------------- */

.detail-panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
  position: relative;
}
.detail-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 22px 24px 20px;
}
.detail-empty {
  height: 100%;
  min-height: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px;
}
.detail-empty .empty-orb {
  width: 92px;
  height: 92px;
  margin-bottom: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  background:
    radial-gradient(circle at 35% 30%, var(--accent-soft-strong), transparent 65%),
    var(--surface-2);
  color: var(--accent);
  box-shadow: 0 0 0 10px rgba(232, 163, 61, 0.03);
}
.detail-empty .empty-orb svg { width: 34px; height: 34px; }
.detail-empty h2 {
  margin: 0;
  font-size: 19px;
  font-weight: 620;
  letter-spacing: -0.03em;
}
.detail-empty p {
  max-width: 40ch;
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 11.5px;
  line-height: 1.7;
}
.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}
.detail-head .kicker { margin: 0; }
.sheet-close { display: none; }
.detail-hero {
  display: grid;
  grid-template-columns: minmax(150px, 246px) minmax(0, 1fr);
  gap: 24px;
  align-items: center;
}
.detail-cover {
  position: relative;
  aspect-ratio: 1;
  border-radius: 14px;
  border: 1px solid var(--line);
  overflow: hidden;
  background:
    radial-gradient(circle at 35% 28%, var(--accent-soft-strong), transparent 60%),
    linear-gradient(135deg, var(--surface-2), var(--surface-3));
  box-shadow: 0 12px 34px rgba(0, 0, 0, 0.20);
}
.detail-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.detail-cover .cover-fallback svg { width: 44px; height: 44px; }
.detail-copy { min-width: 0; }
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.pill {
  padding: 3px 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  font: 9px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.06em;
  white-space: nowrap;
}
.pill.accent {
  border-color: transparent;
  background: var(--accent-soft);
  color: var(--accent);
}
.pill.ok { border-color: transparent; background: var(--ok-soft); color: var(--ok); }
.pill.bad { border-color: transparent; background: var(--danger-soft); color: var(--danger); }
.detail-copy h2 {
  margin: 0;
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 640;
  line-height: 1.08;
  letter-spacing: -0.045em;
  overflow-wrap: anywhere;
}
.detail-artist {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.55;
}
.detail-specs {
  margin: 6px 0 0;
  color: var(--faint);
  font: 10.5px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.02em;
  line-height: 1.6;
}

/* player */

.player {
  margin-top: 24px;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface-2);
}
.player-top {
  display: flex;
  align-items: center;
  gap: 12px;
}
.player-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}
.play-btn {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: var(--accent-ink);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.20);
  transition: transform 150ms cubic-bezier(0.2, 0.8, 0.2, 1), background 150ms ease;
}
.play-btn:hover { transform: scale(1.04); background: var(--accent-strong); }
.play-btn:active { transform: scale(0.97); }
.play-btn:disabled { opacity: 0.38; transform: none; }
.play-btn svg { width: 17px; height: 17px; }
.player-controls .icon-btn { width: 32px; height: 32px; border-radius: 50%; }
.player-state {
  margin-left: auto;
  color: var(--faint);
  font: 9px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.seek-row {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 12px;
}
.seek-time {
  flex: none;
  min-width: 36px;
  color: var(--faint);
  font: 9px var(--font-mono, ui-monospace, monospace);
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.seek {
  flex: 1;
  min-width: 0;
  height: 16px;
  margin: 0;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  cursor: pointer;
}
.seek:disabled { cursor: default; opacity: 0.45; }
.seek::-webkit-slider-runnable-track {
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(to right, var(--accent) 0%, var(--accent) var(--p, 0%), var(--surface-3) var(--p, 0%), var(--surface-3) 100%);
}
.seek::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 10px;
  height: 10px;
  margin-top: -3.5px;
  border: 2px solid var(--surface);
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
}
.seek::-moz-range-track { height: 3px; border-radius: 999px; background: var(--surface-3); }
.seek::-moz-range-progress { height: 3px; border-radius: 999px; background: var(--accent); }
.seek::-moz-range-thumb {
  width: 10px;
  height: 10px;
  border: 2px solid var(--surface);
  border-radius: 50%;
  background: var(--accent);
}

/* actions / settings */

.status-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 16px;
}
.status-line .status-note {
  color: var(--faint);
  font-size: 10px;
  line-height: 1.5;
}
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}
.action-row .btn { padding: 8px 13px; }
.detail-section {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}
.section-head h3 {
  margin: 0;
  font-size: 11.5px;
  font-weight: 650;
  letter-spacing: -0.01em;
}
.text-btn {
  color: var(--accent);
  font-size: 9.5px;
  font-weight: 550;
}
.text-btn:hover { color: var(--accent-strong); }
.setting-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 11px;
}
.setting-line:last-child { border-bottom: 0; }
.setting-line > span:first-child { flex: none; }
.setting-value {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  justify-content: flex-end;
}
.setting-value .truncate {
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink);
  font-size: 10.5px;
}
.setting-note { color: var(--faint); font-size: 10.5px; text-align: right; }
.select {
  appearance: none;
  -webkit-appearance: none;
  max-width: 210px;
  padding: 5px 24px 5px 8px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 10.5px;
  line-height: 1.3;
  cursor: pointer;
  background-image: linear-gradient(45deg, transparent 50%, var(--faint) 50%), linear-gradient(135deg, var(--faint) 50%, transparent 50%);
  background-position: calc(100% - 12px) 50%, calc(100% - 8px) 50%;
  background-size: 4px 4px, 4px 4px;
  background-repeat: no-repeat;
}
.select:hover { border-color: var(--line-strong); }
.switch {
  position: relative;
  flex: none;
  width: 36px;
  height: 20px;
  padding: 2px;
  border-radius: 999px;
  background: var(--surface-3);
  border: 1px solid var(--line);
  transition: background 160ms ease, border-color 160ms ease;
}
.switch span {
  display: block;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--faint);
  transform: translateX(0);
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1), background 160ms ease;
}
.switch[aria-checked="true"] { background: var(--accent); border-color: var(--accent); }
.switch[aria-checked="true"] span { background: var(--accent-ink); transform: translateX(16px); }
.help {
  margin: 8px 0 0;
  color: var(--faint);
  font-size: 10.5px;
  line-height: 1.7;
}
.help code {
  padding: 1px 4px;
  border-radius: 4px;
  background: var(--surface-2);
  font: 9.5px var(--font-mono, ui-monospace, monospace);
  color: var(--muted);
}
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 22px;
  margin: 20px 0 0;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}
.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  padding: 5px 0;
  border-bottom: 1px dashed var(--line);
  font-size: 10.5px;
}
.info-row span { flex: none; color: var(--faint); }
.info-row strong {
  min-width: 0;
  overflow: hidden;
  color: var(--muted);
  font-weight: 500;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* sheet bits (mobile only) */

.sheet-grip { display: none; }
.sheet-backdrop { display: none; }

/* ---------------- footer ---------------- */

.site-footer {
  flex: none;
  border-top: 1px solid var(--line);
}
.footer-inner {
  width: min(1440px, calc(100% - 48px));
  margin: 0 auto;
  padding: 10px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6px 18px;
  color: var(--faint);
  font: 10px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.02em;
  line-height: 1.5;
}
.footer-formats { text-align: right; }
.footer-link {
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 1px solid var(--line-strong);
  padding-bottom: 1px;
  transition: color 150ms ease, border-color 150ms ease;
}
.footer-link:hover { color: var(--accent); border-color: var(--accent); }

/* ---- 页脚格式声明 / 详情错误 ---- */
.footer-formats { line-height: 1.8; }
.footer-formats .fmt-sep { color: var(--faint); padding: 0 4px; }
.footer-key {
  padding: 0;
  border: 0;
  background: none;
  color: var(--accent);
  font: inherit;
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}
.footer-key:hover { color: var(--accent-strong); }
.detail-error-miss { margin: 4px 0 0; color: var(--muted); font-size: 10.5px; }
.detail-error {
  margin-top: 12px;
  padding: 10px 12px;
  border: 1px solid var(--danger);
  border-radius: 10px;
  background: var(--danger-soft);
  font-size: 11.5px;
  line-height: 1.6;
}
.detail-error p { margin: 0; }
.detail-error strong { display: block; margin-bottom: 2px; }
.detail-error details { margin-top: 6px; }
.detail-error summary { cursor: pointer; color: var(--danger); font-size: 10.5px; }
.detail-error details p { margin-top: 4px; color: var(--muted); font-size: 10.5px; }
.diag-list { display: grid; gap: 4px; }
.diag-row {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 10px;
  font-size: 12px;
  color: var(--muted);
}
.diag-row span:first-child { color: var(--faint); }
.diag-row span:last-child { color: var(--ink); word-break: break-all; }
.diag-row code { font: 11px var(--font-mono, ui-monospace, monospace); color: var(--ink); }
.diag-hex {
  width: 100%;
  min-height: 64px;
  resize: vertical;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface-2);
  color: var(--ink);
  font: 11px/1.55 var(--font-mono, ui-monospace, monospace);
  word-break: break-all;
}
.tips { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
.tips-title { margin: 0 0 5px; color: var(--ink); font-size: 11px; font-weight: 600; letter-spacing: 0.02em; }
.tips ul { margin: 0; padding: 0; list-style: none; }
.tips li { position: relative; margin-top: 3px; padding-left: 11px; color: var(--muted); font-size: 10.5px; line-height: 1.45; }
.tips li::before { content: "·"; position: absolute; left: 2px; color: var(--faint); }

@media (max-width: 720px) {
  .footer-inner { align-items: flex-start; flex-direction: column; gap: 3px; }
  .footer-formats { text-align: left; }
}

/* ---------------- settings dialog ---------------- */

.settings-dialog {
  width: min(560px, calc(100vw - 28px));
  max-height: min(84dvh, 760px);
  margin: auto;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.42);
  overflow: hidden;
}
.settings-dialog::backdrop {
  background: var(--scrim);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}
.settings-dialog[open] { animation: dialogIn 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.dialog-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 20px 22px 12px;
  border-bottom: 1px solid var(--line);
}
.dialog-head h2 {
  margin: 0;
  font-size: 19px;
  font-weight: 650;
  letter-spacing: -0.035em;
}
.dialog-body {
  max-height: calc(84dvh - 74px);
  overflow-y: auto;
  padding: 4px 22px 22px;
}
.dialog-body section {
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}
.dialog-body section:last-of-type { border-bottom: 0; }
.dialog-body h3 {
  margin: 0 0 6px;
  color: var(--muted);
  font: 9.5px var(--font-mono, ui-monospace, monospace);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.dialog-body .setting-line { padding: 7px 0; }
.dialog-legal {
  margin: 10px 0 0;
  color: var(--faint);
  font-size: 9.5px;
  line-height: 1.6;
  text-align: center;
}

/* ---------------- toast ---------------- */

.toast {
  position: fixed;
  left: 50%;
  bottom: calc(26px + env(safe-area-inset-bottom));
  z-index: 90;
  max-width: min(92vw, 580px);
  padding: 11px 16px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: var(--ink);
  color: var(--bg);
  font-size: 11.5px;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.34);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 12px) scale(0.98);
  transition: opacity 180ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.toast.show { opacity: 1; transform: translate(-50%, 0) scale(1); }

/* ---------------- motion ---------------- */

@keyframes trackIn {
  from { opacity: 0; transform: translateY(7px); }
  to { opacity: 1; transform: none; }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
@keyframes dialogIn {
  from { opacity: 0; transform: translateY(10px) scale(0.985); }
  to { opacity: 1; transform: none; }
}

/* ---------------- responsive ---------------- */

@media (max-width: 1120px) {
  .workspace { grid-template-columns: minmax(330px, 380px) minmax(0, 1fr); }
  .detail-hero { grid-template-columns: minmax(130px, 190px) minmax(0, 1fr); gap: 18px; }
}

