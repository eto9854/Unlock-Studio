    padding-top: 8px;
  }
  .detail-cover { border-radius: 11px; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18); }
  .detail-copy h2 { font-size: 22px; letter-spacing: -0.035em; }
  .detail-artist { font-size: 11px; margin-top: 4px; }
