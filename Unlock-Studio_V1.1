  }
  const KGM_MASK_TABLE = buildKgmMaskTable();

  function makeKgmV2Cipher(key17, isVpr) {
    return {
      decrypt(input, output, offset) {
        for (let i = 0; i < input.length; i++) {
          const pos = offset + i;
          let med8 = input[i] ^ key17[pos % 17];
          med8 ^= (med8 & 0x0f) << 4;
          let value = med8 ^ KGM_MASK_TABLE[pos % (272 * 16)];
          if (isVpr) value ^= KGM_VPR_DIFF[pos % 17];
          output[i] = value & 0xff;
        }
      }
    };
  }

  function kugouMd5(bytes) {
    const dig = md5(bytes);
    const out = new Uint8Array(16);
    for (let i = 0; i < 16; i += 2) {
      out[i] = dig[14 - i];
      out[i + 1] = dig[15 - i];
    }
    return out;
  }

  function makeKgmV3Cipher(cryptoKey) {
    const slotBox = kugouMd5(new Uint8Array([0x6c, 0x2c, 0x2f, 0x27]));
    const fileBox = new Uint8Array(17);
    fileBox.set(kugouMd5(cryptoKey), 0);
    fileBox[16] = 0x6b;
    return {
      decrypt(input, output, offset) {
        for (let i = 0; i < input.length; i++) {
          const pos = offset + i;
          let v = input[i];
          v ^= fileBox[pos % 17];
          v ^= (v << 4) & 0xff;
          v ^= slotBox[pos % 16];
          v ^= ((pos >>> 0) ^ (pos >>> 8) ^ (pos >>> 16) ^ (pos >>> 24)) & 0xff;
          output[i] = v & 0xff;
        }
      }
    };
  }

  /* ============================== NCM ============================== */

  const NCM_MAGIC = 'CTENFDAM';
  const NCM_CORE_KEY = new Uint8Array([0x68, 0x7a, 0x48, 0x52, 0x41, 0x6d, 0x73, 0x6f, 0x35, 0x6b, 0x49, 0x6e, 0x62, 0x61, 0x78, 0x57]);
  const NCM_META_KEY = new Uint8Array([0x23, 0x31, 0x34, 0x6c, 0x6a, 0x6b, 0x5f, 0x21, 0x5c, 0x5d, 0x26, 0x30, 0x55, 0x3c, 0x27, 0x28]);
  const NCM_KEY_PREFIX = 'neteasecloudmusic';
  const NCM_META_PLAIN_PREFIX = "163 key(Don't modify):";
  const NCM_META_PREFIX = 'music:';
  const NCM_MAX_COVER = 64 * 1024 * 1024;

  function ncmXor(bytes, mask) {
    for (let i = 0; i < bytes.length; i++) bytes[i] ^= mask;
  }
  function ncmBuildKeyBox(key) {
    if (!key || !key.length) throw new UnlockError('BAD_KEY', 'NCM 密钥为空');
    const box = new Uint8Array(256);
    for (let i = 0; i < 256; i++) box[i] = i;
    let j = 0;
    for (let i = 0; i < 256; i++) {
      j = (j + box[i] + key[i % key.length]) & 0xff;
      const t = box[i]; box[i] = box[j]; box[j] = t;
    }
    return box;
  }
  function ncmDecryptChunk(input, output, offset, box) {
    for (let i = 0; i < input.length; i++) {
      const j = (offset + i + 1) & 0xff;
      const a = box[j];
      const b = box[(a + j) & 0xff];
      output[i] = input[i] ^ box[(a + b) & 0xff];
    }
  }
  function ncmDecodeKey(blob) {
    if (!blob.length) throw new UnlockError('BAD_KEY', 'NCM Key 数据为空');
    const x = new Uint8Array(blob);
    ncmXor(x, 0x64);
    let plain;
    try {
      plain = aesUnpad(aes128EcbDecrypt(NCM_CORE_KEY, x));
    } catch (e) {
      throw new UnlockError('KEY_DECRYPT', 'NCM Key 解密失败');
    }
    if (!startsWith(plain, ascii(NCM_KEY_PREFIX))) throw new UnlockError('KEY_PREFIX', 'NCM Key 前缀不匹配');
    return ncmBuildKeyBox(plain.subarray(NCM_KEY_PREFIX.length));
  }
  function ncmDecodeMetadata(blob) {
    if (!blob.length) return null;
    const x = new Uint8Array(blob);
    ncmXor(x, 0x63);
    if (!startsWith(x, ascii(NCM_META_PLAIN_PREFIX))) throw new UnlockError('META_PREFIX', 'NCM Metadata 前缀不匹配');
    const raw = x.subarray(NCM_META_PLAIN_PREFIX.length);
    let b64 = '';
    for (let i = 0; i < raw.length; i++) {
      const c = raw[i];
      if ((c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a) ||
          (c >= 0x30 && c <= 0x39) || c === 0x2b || c === 0x2f || c === 0x3d) b64 += String.fromCharCode(c);
    }
    const decoded = b64decode(b64);
    let plain;
    try {
      plain = aesUnpad(aes128EcbDecrypt(NCM_META_KEY, decoded));
    } catch (e) {
      throw new UnlockError('META_DECRYPT', 'NCM Metadata 解密失败');
    }
    if (!startsWith(plain, ascii(NCM_META_PREFIX))) throw new UnlockError('META_PREFIX', 'NCM Metadata music 前缀不匹配');
    try {
      return JSON.parse(utf8Decode(plain.subarray(NCM_META_PREFIX.length)));
    } catch (e) {
      throw new UnlockError('META_JSON', 'NCM Metadata JSON 解析失败');
    }
  }
  function parseNcmHeader(bytes, fileSize) {
    const size = Number.isFinite(fileSize) && fileSize > 0 ? fileSize : bytes.length;
    const need = (n) => {
      if (n > size) throw new UnlockError('TRUNCATED', '文件已损坏或头部越界');
      if (bytes.length < n) throw new NeedMore(n);
    };
    need(10);
    const magic = latin1Decode(bytes.subarray(0, 8));
    if (magic !== NCM_MAGIC) throw new UnlockError('NOT_NCM', '不是有效的 NCM 文件');
    let off = 10;
    need(off + 4);
    const keyLen = u32le(bytes, off); off += 4;
    if (keyLen > 1024 * 1024) throw new UnlockError('KEY_TOO_LARGE', 'NCM Key 段异常');
    need(off + keyLen);
    const keyBlob = bytes.subarray(off, off + keyLen); off += keyLen;
    need(off + 4);
    const metaLen = u32le(bytes, off); off += 4;
    if (metaLen > 1024 * 1024) throw new UnlockError('META_TOO_LARGE', 'NCM Metadata 段异常');
    need(off + metaLen);
    const metaBlob = bytes.subarray(off, off + metaLen); off += metaLen;
    need(off + 5); off += 5;
    need(off + 4);
    const coverFrameLen = u32le(bytes, off); off += 4;
    need(off + 4);
    const coverLen = u32le(bytes, off); off += 4;
    if (coverLen > NCM_MAX_COVER) throw new UnlockError('COVER_TOO_LARGE', 'NCM 封面段异常');
    const coverOffset = off;
    const audioOffset = coverOffset + Math.max(coverFrameLen, coverLen);
    if (audioOffset > size) throw new UnlockError('TRUNCATED', '文件已损坏或头部越界');
    const keyBox = ncmDecodeKey(keyBlob);
    let metadata = null;
    let metadataError = null;
    if (metaLen > 0) {
      try {
        metadata = ncmDecodeMetadata(metaBlob);
      } catch (e) {
        metadataError = e.message;
      }
    }
    return {
      type: 'ncm',
      keyBox,
      metadata,
      metadataError,
      coverOffset,
      coverLength: coverLen,
      coverFrameLength: coverFrameLen,
      audioOffset,
      audioLength: size - audioOffset
    };
  }

  /* ============================== 探针与密钥查找 ============================== */

  function probeCipher(cipher, probe, offset, size) {
    const take = Math.min(size || 64, probe.length - offset);
    if (take <= 0) return null;
    const out = new Uint8Array(take);
    cipher.decrypt(probe.subarray(offset, offset + take), out, 0);
    return sniffFormat(out);
  }

  function qqCandidates(fileName, footer, hintInfo) {
    const out = [];
    const push = (v) => {
      if (!v) return;
      const s = String(v).trim();
      if (!s) return;
      if (!out.includes(s)) out.push(s);
      const base = s.replace(/\\/g, '/').split('/').pop();
      if (base && base !== s && !out.includes(base)) out.push(base);
    };
    if (hintInfo) {
      push(hintInfo.normalized);
      push(hintInfo.base);
    }
    push(fileName);
    if (footer) {
      push(footer.mediaMid);
      push(footer.resourceFilename);
      push(footer.songid);
      if (Array.isArray(footer.rest)) footer.rest.forEach(push);
    }
    return out;
  }

  function lookupQqEkeys(fileName, footer, keyStore, hintInfo) {
    const candidates = qqCandidates(fileName, footer, hintInfo);
    const byName = keyStore && keyStore.qqByName instanceof Map ? keyStore.qqByName : null;
    const byPath = keyStore && keyStore.qqByPath instanceof Map ? keyStore.qqByPath : null;
    const hits = [];
    if (byName || byPath) {
      for (const cand of candidates) {
        const lc = cand.toLowerCase();
        if (byName && byName.has(lc)) hits.push(...byName.get(lc));
        if (byPath && byPath.has(lc)) hits.push(...byPath.get(lc));
      }
      if (hits.length) return Array.from(new Set(hits));
    }
    const list = (keyStore && keyStore.qq) || [];
    for (const entry of list) {
      const name = entry.name || '';
      const path = entry.path || '';
      for (const cand of candidates) {
        const lc = cand.toLowerCase();
        if (name.toLowerCase() === lc || path.toLowerCase() === lc) {
          hits.push(entry.ekey);
          break;
        }
        if (lc.length >= 8 && path.toLowerCase().includes(lc)) {
          hits.push(entry.ekey);
          break;
        }
      }
    }
    return Array.from(new Set(hits));
  }

  function manualQmcKeys(keyStore) {
    const out = [];
    if (!keyStore || !Array.isArray(keyStore.manual)) return out;
    for (const item of keyStore.manual) {
      if (item && item.master && item.master.length) out.push({ master: item.master, source: 'manual-hex' });
      else if (item && item.ekey) out.push({ ekey: item.ekey, source: 'manual-ekey' });
    }
    return out;
  }

  function tryQmcKeys(entries, probe, audioLength) {
    for (const entry of entries) {
      try {
        let master = null;
        let source = null;
        if (entry && entry.master && entry.master.length) {
          master = entry.master;
          source = entry.source || 'manual-hex';
        } else {
          const ekey = entry && typeof entry === 'object' ? entry.ekey : entry;
          if (!ekey) continue;
          master = deriveQmcKey(ekey);
          source = (entry && entry.source) || null;
        }
        const cipher = createQmc2Cipher(master);
        const fmt = probeCipher(cipher, probe, 0, 64);
        if (fmt) return { key: entry, master, cipher, format: fmt, source };
      } catch (e) {
        /* 继续尝试下一个 */
      }
    }
    return null;
  }

  /* ============================== 识别层（只依赖内容） ============================== */

  function identify(probe, tail, fileSize, fileName) {
    const hint = peelName(fileName);
    const size = Number(fileSize) || 0;
    const detection = {
      kind: 'unknown',
      container: null,
      version: null,
      hint,
      evidence: [],
      candidates: [],
      magicHex: hexDump(probe, 64),
      tailHex: hexDump(tail ? tail.subarray(Math.max(0, tail.length - 4096)) : [], 4096)
    };

    if (!probe || probe.length < 16) {
      detection.evidence.push('头部字节不足 16B，无法判定');
      detection.candidates = ['ncm', 'kgm/vpr/kgg', 'mflac/mgg/qmc', '普通音频'];
      return detection;
    }

    if (startsWith(probe, ascii(NCM_MAGIC))) {
      detection.kind = 'ncm';
      detection.container = 'ncm';
      detection.evidence.push('CTENFDAM 8B 魔数命中');
      detection.candidates = ['ncm'];
      return detection;
    }

    if (startsWith(probe, KGM_MAGIC) || startsWith(probe, VPR_MAGIC)) {
      const isVpr = startsWith(probe, VPR_MAGIC);
      const headerLen = u32le(probe, 0x10);
      const version = u32le(probe, 0x14);
      const slot = u32le(probe, 0x18);
      detection.kind = 'kugou';
      detection.version = version;
      detection.headerLen = headerLen;
      detection.slot = slot;
      detection.container = isVpr ? 'vpr' : (version >= 5 ? 'kgg' : (hint.hints[0] === 'kgma' ? 'kgma' : 'kgm'));
      detection.evidence.push((isVpr ? 'VPR' : 'KGM') + ' 16B 魔数命中', 'headerLen=' + headerLen, 'version=' + version, 'slot=' + slot);
      detection.candidates = ['kgm', 'kgma', 'kgg', 'vpr'];
      return detection;
    }

    // 魔数缺失但结构自洽：KGG 的真实 16B 魔数尚未用样本确认，留结构指纹兜底
    if (probe.length >= 0x48) {
      const headerLen = u32le(probe, 0x10);
      const version = u32le(probe, 0x14);
      const slot = u32le(probe, 0x18);
      if (headerLen >= 0x3c && headerLen <= size && version >= 2 && version <= 8 && slot <= 64) {
        detection.kind = 'kugou-struct';
        detection.version = version;
        detection.headerLen = headerLen;
        detection.slot = slot;
        detection.container = version >= 5 ? 'kgg' : (hint.hints[0] === 'kgma' ? 'kgma' : 'kgm');
        detection.evidence.push('无魔数，但 headerLen/version/slot 自洽（结构指纹）');
        detection.candidates = ['kgg', 'kgm', 'kgma'];
        return detection;
      }
    }

    const footer = analyzeQmcTail(tail, size);
    if (footer) {
      detection.kind = 'qmc';
      detection.version = 2;
      detection.footer = footer;
      detection.container = footer.type === 'QTag' ? 'qmc2-qtag' : footer.type.toLowerCase();
      detection.evidence.push('尾部结构 ' + footer.type + '（' + footer.totalSize + 'B）');
      detection.candidates = ['qmc2', 'qmc1'];
      return detection;
    }

    const plain = sniffFormat(probe);
    if (plain) {
      detection.kind = 'plain';
      detection.audio = plain;
      detection.container = 'plain';
      detection.evidence.push('文件头是普通音频（' + plain.toUpperCase() + '），不是已知加密容器');
      detection.candidates = ['plain'];
      return detection;
    }

    detection.evidence.push('未命中已知容器头 / 尾部特征 / 普通音频头');
    detection.candidates = ['qmc1-static', 'ncm', 'kgm/vpr/kgg', 'mflac/mgg(STag)', '普通音频'];
    return detection;
  }

  /* ============================== 统一计划 ============================== */

  function buildPlan(probe, tail, fileSize, fileName, keyStore) {
    if (!probe || !probe.length) throw new NeedMore(64);
    const size = Number(fileSize);
    const kot = keyStore || {};
    const det = identify(probe, tail, size, fileName);
    const finish = (plan) => {
      plan.detection = {
        kind: det.kind,
        container: det.container,
        version: det.version,
        evidence: det.evidence,
        magicHex: det.magicHex,
        tailHex: det.tailHex,
        hint: det.hint,
        innerFormat: plan.format || null,
        keySource: plan.ekeySource || null
      };
      return plan;
    };

    if (det.kind === 'ncm') {
      const parsed = parseNcmHeader(probe, size);
      const cipher = {
        decrypt(input, output, offset) { ncmDecryptChunk(input, output, offset, parsed.keyBox); }
      };
      if (!parsed.audioLength) throw new UnlockError('EMPTY_AUDIO', '音频段为空');
      // 大封面会把音频起点推到探针之外；此时格式由首块解密后再嗅探
      const fmt = parsed.audioOffset < probe.length ? probeCipher(cipher, probe, parsed.audioOffset, 64) : null;
      return finish({
        platform: 'netease', container: 'ncm', tag: 'NCM', label: '网易云',
        cryptoVersion: null, audioOffset: parsed.audioOffset, audioLength: parsed.audioLength,
        cipher, format: fmt, metadata: parsed.metadata, metadataError: parsed.metadataError,
        coverOffset: parsed.coverOffset, coverLength: parsed.coverLength,
        ekeySource: null
      });
    }

    if (det.kind === 'kugou' || det.kind === 'kugou-struct') {
      return finish(buildKugouPlan(probe, size, det, kot));
    }

    if (det.kind === 'qmc') {
      return finish(buildQmcPlan(probe, tail, size, det, kot));
    }

    if (det.kind === 'plain') {
      throw new UnlockError('NOT_ENCRYPTED', '这是未加密的 ' + det.audio.toUpperCase() + ' 音频，不需要解锁', { audio: det.audio });
    }

    // 未识别：QMCv1 静态盒没有魔数，必须试一次才能下结论
    try {
      return finish(buildQmcPlan(probe, tail, size, det, kot));
    } catch (error) {
      if (error && (error.code === 'QMC_DECRYPT' || error.code === 'FORMAT_UNKNOWN')) {
        throw new UnlockError('FORMAT_UNKNOWN', '无法识别：未命中任何容器头，QMC 静态试解也失败', {
          candidates: det.candidates,
          evidence: det.evidence,
          magicHex: det.magicHex
        });
      }
      throw error;
    }
  }

  function buildKugouPlan(probe, size, det, keyStore) {
    const need = 0x48;
    if (probe.length < need) throw new NeedMore(need);
    const isVpr = startsWith(probe, VPR_MAGIC);
    const headerLen = Number(det.headerLen != null ? det.headerLen : u32le(probe, 0x10));
    const version = Number(det.version != null ? det.version : u32le(probe, 0x14));
    const slot = Number(det.slot != null ? det.slot : u32le(probe, 0x18));
    if (!headerLen || headerLen < 0x3c || headerLen > size) {
      throw new UnlockError('BAD_HEADER', '酷狗文件头异常', { container: det.container, version, headerLen });
    }
    const audioLength = size - headerLen;
    if (audioLength <= 0) throw new UnlockError('EMPTY_AUDIO', '音频段为空');

    const key17 = new Uint8Array(17);
    key17.set(probe.subarray(0x1c, 0x2c), 0);
    const cryptoKey = probe.subarray(0x2c, 0x3c);
    const container = det.container || (isVpr ? 'vpr' : 'kgm');
    const meta = EXT_PLATFORM[container] || null;
    const base = {
      platform: 'kugou', container,
      tag: meta ? meta.tag : 'KGM',
      label: meta ? meta.label : '酷狗',
      audioOffset: headerLen, audioLength,
      metadata: null, coverOffset: 0, coverLength: 0
    };

    const buildV5 = () => {
      const hashLen = u32le(probe, 0x44);
      if (!hashLen || hashLen > 256) throw new UnlockError('BAD_HEADER', '酷狗音频哈希长度异常', { container, version, hashLen });
      if (probe.length < 0x48 + hashLen) throw new NeedMore(0x48 + hashLen);
      const hashId = latin1Decode(probe.subarray(0x48, 0x48 + hashLen));
      let ekey = null;
      if (keyStore && keyStore.kugou) {
        if (keyStore.kugou.has(hashId)) ekey = keyStore.kugou.get(hashId);
        else {
          for (const [k, v] of keyStore.kugou) {
            if (String(k).toLowerCase() === hashId.toLowerCase()) { ekey = v; break; }
          }
        }
      }
      if (!ekey) {
        let tried = 0;
        // 手工粘贴的 EKey / hex 也参与匹配（不依赖 hashId 命中）
        for (const entry of manualQmcKeys(keyStore)) {
          tried += 1;
          try {
            const m = entry.master && entry.master.length ? entry.master : deriveQmcKey(entry.ekey);
            const cipher = createQmc2Cipher(m);
            const fmt = probeCipher(cipher, probe, headerLen, 64);
            if (fmt) return Object.assign({}, base, { cryptoVersion: version, cipher, format: fmt, ekeySource: entry.source || 'manual-ekey' });
          } catch (e) { /* 试下一个 */ }
        }
        if (tried || (keyStore && keyStore.kugou && keyStore.kugou.size)) {
          throw new UnlockError('KUGOU_KEY_INVALID', '已载入酷狗密钥，但没有能解开本文件的 ekey（keyId ' + hashId + '）', {
            container, version, keyId: hashId, keyType: 'KGMusicV3.db / kgg.key 中的 EKey（Base64）', keyBits: '128 位派生密钥'
          });
        }
        throw new UnlockError('DEVICE_BOUND_KEY', '缺少本机酷狗密钥：密钥不在文件内，请在这台电脑导入 KGMusicV3.db / kgg.key', {
          container, version, keyId: hashId, keyType: 'KGMusicV3.db / kgg.key 中的 EKey（Base64）', keyBits: '128 位派生密钥'
        });
      }
      let master;
      try {
        master = deriveQmcKey(ekey);
      } catch (e) {
        throw new UnlockError('KUGOU_KEY_INVALID', '酷狗密钥解析失败，密钥库可能不匹配（' + (e.message || e.code) + '）', {
          container, version, keyId: hashId
        });
      }
      const cipher = createQmc2Cipher(master);
      const fmt = probeCipher(cipher, probe, headerLen, 64);
      if (!fmt) throw new UnlockError('KUGOU_KEY_INVALID', '密钥与文件不匹配，或酷狗版本不受支持', { container, version, keyId: hashId });
      return Object.assign({}, base, { cryptoVersion: version, cipher, format: fmt, ekeySource: 'kugou-db' });
    };

    if (version >= 5) return buildV5();

    if (version === 4) {
      // 参考实现没有可用的 v4 样本，这里只做「结构自洽才尝试」并如实标注未验证
      const hashLen = u32le(probe, 0x44);
      if (hashLen > 0 && hashLen <= 256 && probe.length >= 0x48 + hashLen) return buildV5();
      throw new UnlockError('KUGOU_VERSION_UNVERIFIED', '酷狗 v4 文件：当前实现没有真实样本验证，无法确定密钥结构', {
        container, version, keyType: '未知（v4 未验证）'
      });
    }

    const tryLegacy = (algoVersion) => {
      const cipher = algoVersion === 3 ? makeKgmV3Cipher(cryptoKey) : makeKgmV2Cipher(key17, isVpr);
      const fmt = probeCipher(cipher, probe, headerLen, 64);
      if (!fmt) return null;
      return Object.assign({}, base, { cryptoVersion: algoVersion, cipher, format: fmt, ekeySource: null });
    };

    const order = version === 3 ? [3, 2] : [2, 3];
    for (const algoVersion of order) {
      const plan = tryLegacy(algoVersion);
      if (plan) return plan;
    }
    throw new UnlockError('KUGOU_DECRYPT', '酷狗文件解密校验失败（版本 v' + version + ' / slot ' + slot + '）', {
      container, version, slot
    });
  }

  function buildQmcPlan(probe, tail, size, det, keyStore) {
    const footer = det.footer || parseQmcFooter(tail, size);
    const audioLength = footer && footer.totalSize ? size - footer.totalSize : size;
    if (audioLength <= 0) throw new UnlockError('EMPTY_AUDIO', '音频段为空（尾部结构异常）');
    const hint = det.hint || peelName('');
    const meta = EXT_PLATFORM[hint.hints[0]] || null;
    const container = footer
      ? (footer.type === 'QTag' ? 'qmc2-qtag' : (footer.type === 'Legacy' ? 'qmc2-tailkey' : footer.type.toLowerCase()))
      : 'qmc1';
    const base = {
      platform: 'qq', container,
      tag: meta ? meta.tag : 'QMC',
      label: meta ? meta.label : 'QQ 音乐',
      audioOffset: 0, audioLength,
      metadata: null, coverOffset: 0, coverLength: 0,
      qmcFooter: footer || null
    };
    const result = (cipher, fmt, cryptoVersion, source) =>
      Object.assign({}, base, { cipher, format: fmt, cryptoVersion, ekeySource: source });

    if (footer && footer.ekey) {
      let ok = false;
      try {
        const master = deriveQmcKey(footer.ekey);
        const cipher = createQmc2Cipher(master);
        const fmt = probeCipher(cipher, probe, 0, 64);
        if (fmt) return result(cipher, fmt, 2, footer.type === 'Legacy' ? 'tail-key' : 'embedded');
        ok = true;
      } catch (e) {
        ok = true;
      }
      // QTag 的 EKey 是权威来源，解不开就是密钥/版本问题；Legacy 尾部密钥失效则退回静态盒
      if (ok && footer.type !== 'Legacy') {
        throw new UnlockError('QMC_KEY_INVALID', '内嵌 EKey 解析失败或与文件不匹配', {
          container: footer.type, version: 2, keyType: 'EKey（Base64）', keyBits: '128 位派生密钥'
        });
      }
    }

    if (footer && !footer.ekey) {
      const keys = lookupQqEkeys(det.hint ? det.hint.normalized : '', footer, keyStore, det.hint)
        .map((ekey) => ({ ekey, source: 'qq-db' }));
      let triedAny = false;
      if (keys.length) {
        triedAny = true;
        const hit = tryQmcKeys(keys, probe, audioLength);
        if (hit) return result(hit.cipher, hit.format, 2, hit.source || 'qq-db');
      }
      const all = ((keyStore && keyStore.qq) || [])
        .map((entry) => ({ ekey: entry.ekey, source: 'qq-db' }))
        .filter((entry) => entry.ekey);
      if (all.length && all.length <= 300) {
        triedAny = true;
        const hit = tryQmcKeys(all, probe, audioLength);
        if (hit) return result(hit.cipher, hit.format, 2, 'qq-db-scan');
      }
      const manual = manualQmcKeys(keyStore);
      if (manual.length) {
        triedAny = true;
        const hit = tryQmcKeys(manual, probe, audioLength);
        if (hit) return result(hit.cipher, hit.format, 2, hit.source);
      }
      if (triedAny) {
        throw new UnlockError('QMC_KEY_INVALID', '已载入 QQ 密钥库，但没有一条能解开这个文件', {
          container: footer.type, version: 2, mediaMid: footer.mediaMid,
          keyType: 'EKey（Base64）', keyBits: '128 位派生密钥'
        });
      }
      if (footer.type === 'MusicEx') {
        throw new UnlockError('ONLINE_DRM_UNSUPPORTED', '密钥由服务端会话下发，只存在播放器进程内存，本地没有任何持久副本', {
          container: footer.type, version: 2, mediaMid: footer.mediaMid,
          keyType: '内存下发 EKey（无本地副本）', keyBits: '128 位派生密钥（Base64 EKey）'
        });
      }
      throw new UnlockError('DEVICE_BOUND_KEY', '缺少本机 QQ 密钥：密钥不在文件内，需在同一台设备导入本机客户端的密钥库（没有该库则无法解密）', {
        container: footer.type, version: 2,
        mediaMid: footer.mediaMid,
        keyType: '设备/账号绑定的 EKey（player_process_db）',
        keyBits: '128 位派生密钥（Base64 EKey）'
      });
    }

    // 无 footer，或 Legacy 尾部密钥失效：QMCv1 静态盒
    const staticCipher = makeStaticCipher();
    const fmt = probeCipher(staticCipher, probe, 0, 64);
    if (fmt) return result(staticCipher, fmt, 1, 'static');

    const staticV1 = makeStaticV1Cipher();
    const fmtV1 = probeCipher(staticV1, probe, 0, 64);
    if (fmtV1) return result(staticV1, fmtV1, 1, 'static-v1');

    throw new UnlockError('QMC_DECRYPT', 'QMC 解密校验失败：尾部结构与已知版本不符，或文件不完整', {
      container: det.kind === 'unknown' ? '未识别' : container
    });
  }

  /* ============================== 标签 / 封面提取 ============================== */

  function decodeTextFrame(bytes) {
    if (!bytes || !bytes.length) return '';
    const enc = bytes[0];
    let body = bytes.subarray(1);
    if (enc === 0) {
      return latin1Decode(body).replace(/\0+$/g, '');
    }
    if (enc === 1) {
      let le = true;
      if (body[0] === 0xff && body[1] === 0xfe) { le = true; body = body.subarray(2); }
      else if (body[0] === 0xfe && body[1] === 0xff) { le = false; body = body.subarray(2); }
      try {
        return new TextDecoder(le ? 'utf-16le' : 'utf-16be').decode(body).replace(/\0+$/g, '');
      } catch (e) {
        return latin1Decode(body).replace(/\0+$/g, '');
      }
    }
    if (enc === 2) {
      try { return new TextDecoder('utf-16be').decode(body).replace(/\0+$/g, ''); }
      catch (e) { return ''; }
    }
    return utf8Decode(body).replace(/\0+$/g, '');
  }

  function parseId3(bytes, totalLength) {
    if (!startsWith(bytes, ascii('ID3'))) return null;
    if (bytes.length < 10) return null;
    const major = bytes[3];
    const flags = bytes[5];
    const size = ((bytes[6] & 0x7f) << 21) | ((bytes[7] & 0x7f) << 14) | ((bytes[8] & 0x7f) << 7) | (bytes[9] & 0x7f);
    let pos = 10;
    if (flags & 0x40) {
      if (major === 4) {
        const extSize = ((bytes[pos] & 0x7f) << 21) | ((bytes[pos + 1] & 0x7f) << 14) | ((bytes[pos + 2] & 0x7f) << 7) | (bytes[pos + 3] & 0x7f);
        pos += extSize;
      } else if (major === 3) {
        const extSize = u32be(bytes, pos);
        pos += 4 + extSize;
      }
    }
    const end = Math.min(bytes.length, 10 + size);
    let title = '', artist = '', album = '', year = '';
    let cover = null;
    while (pos + 10 <= end) {
      if (bytes[pos] === 0) break;
      const id = latin1Decode(bytes.subarray(pos, pos + 4));
      if (!/^[A-Z0-9]{4}$/.test(id)) break;
      let frameSize;
      if (major === 4) {
        frameSize = ((bytes[pos + 4] & 0x7f) << 21) | ((bytes[pos + 5] & 0x7f) << 14) | ((bytes[pos + 6] & 0x7f) << 7) | (bytes[pos + 7] & 0x7f);
      } else {
        frameSize = u32be(bytes, pos + 4);
      }
      const frameFlags = u16be(bytes, pos + 8);
      pos += 10;
      if (frameSize <= 0 || pos + frameSize > end) break;
      const frame = bytes.subarray(pos, pos + frameSize);
      if (id === 'TIT2') title = decodeTextFrame(frame);
      else if (id === 'TPE1') artist = decodeTextFrame(frame);
      else if (id === 'TALB') album = decodeTextFrame(frame);
      else if (id === 'TYER' || id === 'TDRC') year = decodeTextFrame(frame);
      else if (id === 'APIC' && !cover) cover = parseApic(frame, frameFlags);
      pos += frameSize;
    }
    let duration = 0;
    let bitrate = 0;
    const audioStart = Math.min(bytes.length, 10 + size);
    const audioBytes = Math.max(0, (totalLength || bytes.length) - audioStart);
    const info = parseMp3Frame(bytes, audioStart);
    if (info) {
      bitrate = info.bitrate;
      duration = info.bitrate ? Math.round((audioBytes * 8) / info.bitrate * 1000) : 0;
    }
    const metadata = {};
    if (title) metadata.musicName = title;
    if (artist) metadata.artist = artist.split('/').map((s) => s.trim()).filter(Boolean);
    if (album) metadata.album = album;
    if (year) metadata.year = year;
    if (duration) metadata.duration = duration;
    if (bitrate) metadata.bitrate = bitrate;
    return { metadata: Object.keys(metadata).length ? metadata : null, cover };
  }

  function parseApic(frame, flags) {
    if (!frame.length) return null;
    let pos = 0;
    const enc = frame[pos++];
    let mimeEnd = pos;
    while (mimeEnd < frame.length && frame[mimeEnd] !== 0) mimeEnd++;
    const mime = latin1Decode(frame.subarray(pos, mimeEnd));
    pos = mimeEnd + 1;
    if (pos >= frame.length) return null;
    pos += 1; // picture type
    let descEnd = pos;
    if (enc === 1 || enc === 2) {
      while (descEnd + 1 < frame.length && !(frame[descEnd] === 0 && frame[descEnd + 1] === 0)) descEnd += 2;
      descEnd += 2;
    } else {
      while (descEnd < frame.length && frame[descEnd] !== 0) descEnd++;
      descEnd += 1;
    }
    pos = Math.min(descEnd, frame.length);
    const data = frame.subarray(pos);
    if (!data.length) return null;
    const detected = detectCoverMime(data) || (/png/i.test(mime) ? 'image/png' : 'image/jpeg');
    return { bytes: data, mime: detected };
  }

  function parseMp3Frame(bytes, start) {
    for (let i = Math.max(0, start); i + 4 <= bytes.length; i++) {
      if (bytes[i] !== 0xff || (bytes[i + 1] & 0xe0) !== 0xe0) continue;
      const version = (bytes[i + 1] >>> 3) & 3;
      const layer = (bytes[i + 1] >>> 1) & 3;
      const bitrateIdx = (bytes[i + 2] >>> 4) & 0xf;
      const sampleIdx = (bytes[i + 2] >>> 2) & 3;
      if (version === 1 || layer === 0 || bitrateIdx === 0 || bitrateIdx === 15 || sampleIdx === 3) continue;
      const tables = {
        // MPEG1 三种 layer 的码率表（下标 1=Layer III, 2=Layer II, 3=Layer I）
        1: [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320],
        2: [0, 32, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384],
        3: [0, 32, 64, 96, 128, 160, 192, 224, 256, 288, 320, 352, 384, 416, 448],
        // MPEG2 / MPEG2.5 的 Layer II / III 共用表
        0: [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160]
      };
      const table = version === 3 ? tables[layer] : tables[0];
      const bitrateKbps = table[bitrateIdx];
      if (!bitrateKbps) continue;
      return { bitrate: bitrateKbps * 1000 };
    }
    return null;
  }

  function parseFlac(bytes) {
    if (!startsWith(bytes, ascii('fLaC'))) return null;
    let pos = 4;
    let metadata = null;
    let cover = null;
    let duration = 0;
    let bitrate = 0;
    while (pos + 4 <= bytes.length) {
      const header = bytes[pos];
      const last = !!(header & 0x80);
      const type = header & 0x7f;
      const len = u24be(bytes, pos + 1);
      pos += 4;
      if (len > bytes.length - pos) break;
      const data = bytes.subarray(pos, pos + len);
      if (type === 0 && len >= 34) {
        const sr = (data[10] << 12) | (data[11] << 4) | (data[12] >>> 4);
        const total = ((data[13] & 0x0f) * 0x100000000) + ((data[14] << 24) >>> 0) + (data[15] << 16) + (data[16] << 8) + data[17];
        if (sr > 0 && total > 0) duration = Math.round((total / sr) * 1000);
      } else if (type === 4) {
        metadata = metadata || {};
        let p = 0;
        const vendorLen = u32le(data, p); p += 4 + vendorLen;
        const count = u32le(data, p); p += 4;
        const artists = [];
        for (let i = 0; i < count && p + 4 <= data.length; i++) {
          const clen = u32le(data, p); p += 4;
          if (clen > data.length - p) break;
          const comment = utf8Decode(data.subarray(p, p + clen)); p += clen;
          const eq = comment.indexOf('=');
          if (eq < 0) continue;
          const key = comment.slice(0, eq).toUpperCase();
          const value = comment.slice(eq + 1);
          if (key === 'TITLE') metadata.musicName = value;
          else if (key === 'ARTIST') artists.push(value);
          else if (key === 'ALBUM') metadata.album = value;
          else if (key === 'DATE' || key === 'YEAR') metadata.year = value;
          else if (key === 'GENRE') metadata.genre = value;
        }
        if (artists.length) metadata.artist = artists;
      } else if (type === 6 && len >= 32) {
        let p = 0;
        const picType = u32be(data, p); p += 4;
        const mimeLen = u32be(data, p); p += 4;
        const mime = latin1Decode(data.subarray(p, p + mimeLen)); p += mimeLen;
        const descLen = u32be(data, p); p += 4 + descLen;
        p += 16; // width/height/depth/colors
        const dataLen = u32be(data, p); p += 4;
        if (dataLen && p + dataLen <= data.length) {
          const bytesCover = data.subarray(p, p + dataLen);
          if (!cover || picType === 3) cover = { bytes: bytesCover, mime: detectCoverMime(bytesCover) || (/png/i.test(mime) ? 'image/png' : 'image/jpeg') };
        }
      }
      pos += len;
      if (last) break;
    }
    if (metadata && duration) metadata.duration = duration;
    if (metadata && bitrate) metadata.bitrate = bitrate;
    return { metadata: metadata && (metadata.musicName || metadata.artist || metadata.album) ? metadata : null, cover, duration: duration || 0 };
  }

  function extractTags(bytes, totalLength) {
    if (!bytes || !bytes.length) return { metadata: null, cover: null, duration: 0 };
    const flac = parseFlac(bytes);
    if (flac) return { metadata: flac.metadata, cover: flac.cover, duration: flac.duration || (flac.metadata && flac.metadata.duration) || 0 };
    const id3 = parseId3(bytes, totalLength);
    if (id3) {
      const meta = id3.metadata || {};
      return { metadata: id3.metadata, cover: id3.cover, duration: meta.duration || 0 };
    }
    return { metadata: null, cover: null, duration: 0 };
  }

  /* ============================== SQLite 读取 ============================== */

  function sqliteHeader(bytes) {
    if (!startsWith(bytes, ascii('SQLite format 3\u0000'))) return null;
    let pageSize = u16be(bytes, 16);
    if (pageSize === 1) pageSize = 65536;
    if (pageSize < 512 || (pageSize & (pageSize - 1)) !== 0) return null;
    const reserved = bytes[20];
    const usable = pageSize - reserved;
    if (usable < 480) return null;
    return { pageSize, reserved, usable, pages: Math.floor(bytes.length / pageSize) };
  }

  function sqliteVarint(b, pos) {
    let value = 0;
    let shift = 0;
    for (let i = 0; i < 9 && pos < b.length; i++) {
      const byte = b[pos++];
      if (i === 8) { value = value * 256 + byte; break; }
      value = value * 128 + (byte & 0x7f);
      if (!(byte & 0x80)) break;
    }
    return { value, pos };
  }

  function sqliteRecord(payload) {
    let p = 0;
    const headerSize = sqliteVarint(payload, p);
    p = headerSize.pos;
    const types = [];
    let guard = 0;
    while (p < headerSize.value && guard++ < 4096) {
      const t = sqliteVarint(payload, p);
      types.push(t.value);
      p = t.pos;
    }
    let dataPos = headerSize.value;
    const values = [];
    for (const t of types) {
      if (t === 0) { values.push(null); continue; }
      let size = 0;
      let isText = false;
      if (t >= 1 && t <= 6) {
        size = [0, 1, 2, 3, 4, 6, 8][t];
        let raw = 0;
        for (let i = 0; i < size; i++) raw = raw * 256 + payload[dataPos + i];
        const sign = Math.pow(2, size * 8 - 1);
        values.push(raw >= sign ? raw - Math.pow(2, size * 8) : raw);
        dataPos += size;
        continue;
      }
      if (t === 7) {
        const raw = new Uint8Array(8);
        for (let i = 0; i < 8; i++) raw[i] = payload[dataPos + i];
        const hi = u32be(raw, 0);
        const lo = u32be(raw, 4);
        const sign = (hi & 0x80000000) ? -1 : 1;
        const exp = (hi >>> 20) & 0x7ff;
        const frac = ((hi & 0xfffff) * 0x100000000 + lo);
        const val = sign * frac * Math.pow(2, exp - 1075);
        values.push(exp === 0 && frac === 0 ? 0 : val);
        dataPos += 8;
        continue;
      }
      if (t === 8) { values.push(0); continue; }
      if (t === 9) { values.push(1); continue; }
      if (t === 10 || t === 11) { values.push(null); continue; }
      if (t >= 12) {
        if (t % 2 === 0) { size = (t - 12) / 2; isText = false; }
        else { size = (t - 13) / 2; isText = true; }
        const slice = payload.subarray(dataPos, dataPos + size);
        values.push(isText ? utf8Decode(slice) : slice);
        dataPos += size;
      }
    }
    return values;
  }

  function sqliteReadTable(db, rootPage) {
    const header = sqliteHeader(db);
    if (!header) throw new UnlockError('SQLITE_HEADER', '数据库头无效');
    const { pageSize, usable, pages } = header;
    const rows = [];
    const visited = new Set();
    const walk = (pageNo) => {
      if (!pageNo || pageNo > pages || visited.has(pageNo)) return;
      visited.add(pageNo);
      const page = db.subarray((pageNo - 1) * pageSize, pageNo * pageSize);
      const hdr = pageNo === 1 ? 100 : 0;
      if (hdr + 8 > page.length) return;
      const type = page[hdr];
      if (type === 0x0d) {
        const count = u16be(page, hdr + 3);
        const ptr = hdr + 8;
        for (let i = 0; i < count; i++) {
          const cellOff = u16be(page, ptr + i * 2);
          if (cellOff + 2 > page.length) continue;
          let p = cellOff;
          const ps = sqliteVarint(page, p); p = ps.pos;
          const rid = sqliteVarint(page, p); p = rid.pos;
          readSqlitePayload(db, page, p, ps.value, usable, pageSize, (payload) => {
            rows.push(sqliteRecord(payload));
          });
        }
      } else if (type === 0x05) {
        const count = u16be(page, hdr + 3);
        const right = u32be(page, hdr + 8);
        const ptr = hdr + 12;
        for (let i = 0; i < count; i++) {
          const child = u32be(page, ptr + i * 4);
          walk(child);
        }
        walk(right);
      } else if (type === 0x02 || type === 0x0a) {
        // 索引页不承载表数据，忽略
      }
    };
    walk(rootPage);
    return rows;
  }

  function readSqlitePayload(db, page, start, size, usable, pageSize, cb) {
    if (size > 16 * 1024 * 1024) throw new UnlockError('SQLITE_RECORD', '密钥库记录异常（超过 16MB）');
    const maxLocal = usable - 35;
    const minLocal = Math.floor(((usable - 12) * 32) / 255) - 23;
    let local;
    if (size <= maxLocal) local = size;
    else {
      const k = minLocal + ((size - minLocal) % (usable - 4));
      local = k <= maxLocal ? k : minLocal;
    }
    const out = new Uint8Array(size);
    out.set(page.subarray(start, start + local), 0);
    let filled = local;
    if (filled < size) {
      let next = u32be(page, start + local);
      let guard = 0;
      while (filled < size && next && guard++ < 10000) {
        const off = (next - 1) * pageSize;
        if (off < 0 || off + pageSize > db.length) break;
        const ov = db.subarray(off, off + pageSize);
        next = u32be(ov, 0);
        const take = Math.min(usable - 4, size - filled);
        out.set(ov.subarray(4, 4 + take), filled);
        filled += take;
      }
    }
    cb(out);
  }

  function sqliteTables(db) {
    const rows = sqliteReadTable(db, 1);
    const list = [];
    for (const row of rows) {
      if (!row || row.length < 5) continue;
      if (row[0] !== 'table') continue;
      const name = String(row[1] || '');
      const root = Number(row[3]);
      const sql = String(row[4] || '');
      if (name && root) list.push({ name, root, sql });
    }
    return list;
  }

  function sqliteColumns(sql) {
    const open = String(sql).indexOf('(');
    if (open < 0) return [];
    let depth = 0;
    let quote = '';
    let cur = '';
    const parts = [];
    for (let i = open + 1; i < sql.length; i++) {
      const ch = sql[i];
      if (quote) {
        cur += ch;
        if (ch === quote) quote = '';
        continue;
      }
      if (ch === '"' || ch === "'" || ch === '`') { quote = ch; cur += ch; continue; }
      if (ch === '(') { depth++; cur += ch; continue; }
      if (ch === ')') { if (depth === 0) break; depth--; cur += ch; continue; }
      if (ch === ',' && depth === 0) { parts.push(cur); cur = ''; continue; }
      cur += ch;
    }
    if (cur.trim()) parts.push(cur);
    return parts.map((part) => {
      const t = part.trim();
      const m = t.match(/^["'`\[]?([A-Za-z0-9_]+)/);
      return m ? m[1] : '';
    }).filter((name) => name && !/^(CONSTRAINT|PRIMARY|UNIQUE|CHECK|FOREIGN)$/i.test(name));
  }

  function collectDbKeys(db) {
    const tables = sqliteTables(db);
    const found = {
      kugou: [],
      qq: [],
      tables: tables.map((t) => t.name)
    };
    const byName = new Map(tables.map((t) => [t.name.toLowerCase(), t]));
    const read = (table, pathCol, keyCol) => {
      const t = byName.get(table.toLowerCase());
      if (!t) return;
      const cols = sqliteColumns(t.sql).map((c) => c.toLowerCase());
      const pi = cols.indexOf(pathCol.toLowerCase());
      const ki = cols.indexOf(keyCol.toLowerCase());
      if (pi < 0 || ki < 0) return;
      const rows = sqliteReadTable(db, t.root);
      for (const row of rows) {
        const path = row[pi] == null ? '' : String(row[pi]);
        const keyRaw = row[ki];
        let key = '';
        if (typeof keyRaw === 'string') key = keyRaw;
        else if (keyRaw && keyRaw.length) key = latin1Decode(keyRaw);
        key = key.trim();
        if (!path || !key) continue;
        if (/sharefileitems/i.test(table)) found.kugou.push([path, key]);
        else found.qq.push({ path, name: path.replace(/\\/g, '/').split('/').pop(), ekey: key });
      }
    };
    read('ShareFileItems', 'EncryptionKeyId', 'EncryptionKey');
    read('audio_file_ekey_table', 'file_path', 'ekey');
    read('EKeyFileInfo', 'filePath', 'eKey');
    read('p2p_cache_info_table', 'file_id', 'ekey');
    return found;
  }

  /* ---------- 酷狗 KGMusicV3.db 解密 ---------- */

  const KGG_DB_PAGE = 0x400;
  const KGG_DB_MASTER = new Uint8Array([
    0x1d, 0x61, 0x31, 0x45, 0xb2, 0x47, 0xbf, 0x7f,
    0x3d, 0x18, 0x96, 0x72, 0x14, 0x4f, 0xe4, 0xbf
  ]);

  function kggDerivePageKey(pageNo) {
    const buf = new Uint8Array(0x18);
    buf.set(KGG_DB_MASTER, 0);
    buf[0x10] = pageNo & 0xff;
    buf[0x11] = (pageNo >>> 8) & 0xff;
    buf[0x12] = (pageNo >>> 16) & 0xff;
    buf[0x13] = (pageNo >>> 24) & 0xff;
    buf[0x14] = 0x73; buf[0x15] = 0x41; buf[0x16] = 0x6c; buf[0x17] = 0x54;
    return md5(buf);
  }

  function kggNextIv(seed) {
    const left = Math.imul(seed, 0x9ef4) >>> 0;
    const right = Math.imul(Math.floor((seed >>> 0) / 0xce26), 0x7fffff07) >>> 0;
    let value = (left - right) >>> 0;
    if ((value & 0x80000000) === 0) return value;
    return (value + 0x7fffff07) >>> 0;
  }

  function kggDerivePageIv(pageNo) {
    const buf = new Uint8Array(16);
    let seed = pageNo + 1;
    for (let i = 0; i < 16; i += 4) {
      seed = kggNextIv(seed);
      buf[i] = seed & 0xff;
      buf[i + 1] = (seed >>> 8) & 0xff;
      buf[i + 2] = (seed >>> 16) & 0xff;
      buf[i + 3] = (seed >>> 24) & 0xff;
    }
    return md5(buf);
  }

  function kggValidatePage1(page) {
    if (page.length < 0x18) return false;
    const o10 = u32le(page, 0x10);
    const o14 = u32le(page, 0x14);
    const pageSize = ((o10 & 0xff) << 8) | ((o10 & 0xff00) << 16);
    const diff = pageSize - 0x200;
    return o14 === 0x20204000 && diff >= 0 && diff <= 0xfe00 && ((pageSize - 1) & pageSize) === 0;
  }

  async function decryptKugouDatabase(bytes, onProgress) {
    if (sqliteHeader(bytes)) return bytes;
    if (!bytes.length || bytes.length % KGG_DB_PAGE !== 0) {
      throw new UnlockError('KGG_DB_SIZE', 'KGMusicV3.db 大小异常（不是 1024 的整数倍）');
    }
    if (bytes.length > 64 * 1024 * 1024) throw new UnlockError('KGG_DB_SIZE', '密钥库超过 64MB，已拒绝处理');
    const out = new Uint8Array(bytes);
    const pages = out.length / KGG_DB_PAGE;
    const page1 = out.subarray(0, KGG_DB_PAGE);
    if (!kggValidatePage1(page1)) throw new UnlockError('KGG_DB_FORMAT', '不是可识别的酷狗密钥库');
    const expected = page1.slice(0x10, 0x18);
    page1.set(page1.subarray(8, 16), 0x10);
    const key = kggDerivePageKey(1);
    const iv = kggDerivePageIv(1);
    const plain1 = aes128CbcDecrypt(page1.subarray(0x10), key, iv);
    page1.set(plain1, 0x10);
    if (page1[0x10] !== expected[0] || page1[0x11] !== expected[1] ||
        page1[0x12] !== expected[2] || page1[0x13] !== expected[3] ||
        page1[0x14] !== expected[4] || page1[0x15] !== expected[5] ||
        page1[0x16] !== expected[6] || page1[0x17] !== expected[7]) {
      throw new UnlockError('KGG_DB_KEY', '密钥库解密校验失败（master key 或版本不匹配）');
    }
    page1.set(ascii('SQLite format 3\u0000'), 0);
    for (let pageNo = 2; pageNo <= pages; pageNo++) {
      const off = (pageNo - 1) * KGG_DB_PAGE;
      const page = out.subarray(off, off + KGG_DB_PAGE);
      const plain = aes128CbcDecrypt(page, kggDerivePageKey(pageNo), kggDerivePageIv(pageNo));
      out.set(plain, off);
      if (onProgress && pageNo % 256 === 0) {
        onProgress(pageNo / pages);
        await new Promise((resolve) => setTimeout(resolve, 0));
      }
    }
    if (!sqliteHeader(out)) throw new UnlockError('KGG_DB_KEY', '密钥库解密后不是有效 SQLite 数据库');
    return out;
  }

  /* ============================== 密钥库载入 ============================== */

  function parseKugouKeyText(text) {
    const out = [];
    const lines = String(text || '').replace(/^\uFEFF/, '').split(/\r?\n/);
    for (const line of lines) {
      const s = line.trim();
      if (!s) continue;
      const idx = s.indexOf('$');
      if (idx <= 0) continue;
      const id = s.slice(0, idx).trim();
      const ekey = s.slice(idx + 1).trim();
      if (id && ekey && isBase64Text(ascii(ekey))) out.push([id, ekey]);
    }
    return out;
  }

  async function loadKeyBundle(buffer, fileName, onProgress) {
    const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
    const name = String(fileName || '');
    if (bytes.length > 64 * 1024 * 1024) throw new UnlockError('KEY_DB_SIZE', '密钥库超过 64MB，已拒绝处理');
    const result = { kugou: [], qq: [], tables: [], kind: 'unknown', note: '' };

    if (bytes.length >= 2 && (bytes[0] === 0x7b || bytes[0] === 0x5b)) {
      try {
        const parsed = JSON.parse(utf8Decode(bytes).replace(/^\uFEFF/, ''));
        const map = parsed.keys && typeof parsed.keys === 'object' ? parsed.keys : parsed;
        if (map && !Array.isArray(map)) {
          for (const [id, key] of Object.entries(map)) {
            if (typeof key === 'string' && id) result.kugou.push([id, key]);
          }
        } else if (Array.isArray(parsed)) {
          for (const row of parsed) {
            if (row && row.hash && row.key) result.kugou.push([String(row.hash), String(row.key)]);
            else if (row && row.name && row.ekey) result.qq.push({ path: String(row.name), name: String(row.name), ekey: String(row.ekey) });
          }
        }
        if (result.kugou.length) { result.kind = 'kugou-json'; return result; }
        if (result.qq.length) { result.kind = 'qq-json'; return result; }
      } catch (e) { /* 继续按文本处理 */ }
    }

    let db = null;
    let decrypted = false;
    if (sqliteHeader(bytes)) {
      db = bytes;
    } else if (bytes.length >= 8 && bytes.length % KGG_DB_PAGE === 0) {
      try {
        db = await decryptKugouDatabase(bytes, onProgress);
        decrypted = true;
      } catch (e) {
        db = null;
      }
    }

    if (db) {
      const found = collectDbKeys(db);
      result.kugou = found.kugou;
      result.qq = found.qq;
      result.tables = found.tables;
      if (found.kugou.length && found.qq.length) result.kind = 'mixed';
      else if (found.kugou.length) result.kind = 'kugou-db';
      else if (found.qq.length) result.kind = 'qq-db';
      else result.kind = 'db-empty';
      result.note = decrypted ? 'KGMusicV3.db（已解密）' : 'SQLite 密钥库';
      if (found.kugou.length || found.qq.length) return result;
    }

    if (bytes.length < 8 * 1024 * 1024) {
      const text = utf8Decode(bytes).replace(/^\uFEFF/, '');
      const pairs = parseKugouKeyText(text);
      if (pairs.length) {
        result.kugou = pairs;
        result.kind = 'kugou-key';
        result.note = 'kgg.key';
        return result;
      }
    }

    throw new UnlockError('KEY_DB_FORMAT', '无法识别 ' + (name || '该文件') + '：不是 kgg.key、QQ 密钥库或酷狗 KGMusicV3.db');
  }

  /* ============================== 导出 ============================== */

  global.AudioUnlock = {
    UnlockError,
    NeedMore,
    FORMAT_INFO,
    EXT_PLATFORM,
    CONTAINER_EXTS,
    AUDIO_EXTS,
    sniffFormat,
    detectCoverMime,
    sanitizeBase,
    buildFilename,
    parseNcmHeader,
    identify,
    peelName,
    normalizeName,
    hexDump,
    buildPlan,
    extractTags,
    parseQmcFooter,
    analyzeQmcTail,
    deriveQmcKey,
    createQmc2Cipher,
    loadKeyBundle,
    parseKugouKeyText,
    decryptKugouDatabase,
    md5
  };
})(typeof window !== 'undefined' ? window : globalThis);

