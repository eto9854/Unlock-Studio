    transform: translateY(105%);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .detail-panel.is-open { transform: translateY(0); }
  .detail-scroll {
    max-height: 84dvh;
    overflow-y: auto;
    padding: 0 16px calc(18px + env(safe-area-inset-bottom));
  }
  .detail-head { display: none; }
  .sheet-grip {
    display: grid;
    place-items: center;
    height: 26px;
    flex: none;
    touch-action: none;
  }
  .sheet-grip span {
    width: 38px;
    height: 4px;
